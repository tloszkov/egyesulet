---
import { useTranslations } from '../i18n/utils';
const { lang } = Astro.props;
const t = useTranslations(lang as any);

const currentYear = new Date().getFullYear();
---

<footer style="background: #0f172a; color: white; padding: 8rem 0 4rem;">
  <div class="container">
    <div class="footer-grid" style="display: grid; grid-template-columns: 2fr 1fr 1.5fr; gap: 4rem;">
      <div class="footer-brand">
        <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 2rem;">
            <img src="/logo.png" alt="Logo" style="height: 54px; filter: brightness(0) invert(1);" />
            <h3 style="font-size: 1.5rem; letter-spacing: -0.02em;">{lang === 'en' ? 'A Chance for the Community' : 'O Șansă Pentru Comunitate'}</h3>
        </div>
        <p style="color: #94a3b8; font-size: 1.1rem; line-height: 1.7; max-width: 400px;">
            {lang === 'hu' ? 'A helyi közösség fejlesztése, az erőforrások aktiválása és egy fenntartható jövő építése Cristuru Secuiesc környékén.' : lang === 'ro' ? 'Dezvoltarea comunității locale, activarea resurselor și construirea unui viitor durabil în zona Cristuru Secuiesc.' : 'Developing the local community, activating resources, and building a sustainable future in the Cristuru Secuiesc region.'}
        </p>
      </div>

      <div class="footer-links">
        <h4 style="margin-bottom: 2rem; font-size: 1rem; text-transform: uppercase; letter-spacing: 0.1em; color: #4f46e5;">{lang === 'hu' ? 'Linkek' : lang === 'ro' ? 'Link-uri' : 'Links'}</h4>
        <ul style="list-style: none; display: flex; flex-direction: column; gap: 1rem;">
          <li><a href={lang === 'ro' ? '/despre-noi' : lang === 'hu' ? '/hu/rolunk' : '/en/about'} class="footer-link-item">{t('nav.about')}</a></li>
          <li><a href={lang === 'ro' ? '/proiecte' : lang === 'hu' ? '/hu/projektek' : '/en/projects'} class="footer-link-item">{t('nav.projects')}</a></li>
          <li><a href={lang === 'ro' ? '/stiri' : lang === 'hu' ? '/hu/hirek' : '/en/news'} class="footer-link-item">{t('nav.news')}</a></li>
          <li><a href={lang === 'ro' ? '/evenimente' : lang === 'hu' ? '/hu/esemenyek' : '/en/events'} class="footer-link-item">{lang === 'hu' ? 'Események' : lang === 'ro' ? 'Evenimente' : 'Events'}</a></li>
          <li><a href={lang === 'ro' ? '/transparenta' : lang === 'hu' ? '/hu/atlathatosag' : '/en/transparency'} class="footer-link-item">{lang === 'hu' ? 'Átláthatóság' : lang === 'ro' ? 'Transparență' : 'Transparency'}</a></li>
          <li><a href={lang === 'ro' ? '/privacy' : lang === 'hu' ? '/hu/adatvedelem' : '/en/privacy'} class="footer-link-item">{lang === 'hu' ? 'Adatvédelem' : lang === 'ro' ? 'Confidențialitate' : 'Privacy Policy'}</a></li>
          <li><button id="cookie-settings-btn" class="footer-link-item footer-cookie-btn">{lang === 'hu' ? 'Sütik' : lang === 'ro' ? 'Cookie-uri' : 'Cookies'}</button></li>
        </ul>
      </div>

      <div class="footer-contact">
        <h4 style="margin-bottom: 2rem; font-size: 1rem; text-transform: uppercase; letter-spacing: 0.1em; color: #ec4899;">{t('nav.contact')}</h4>
        <div style="display: flex; flex-direction: column; gap: 1rem; color: #cbd5e1;">
            <div class="footer-contact-card">
                <span style="font-size: 0.8rem; color: #64748b; display: block; margin-bottom: 0.5rem; text-transform: uppercase; letter-spacing: 0.05em;">{lang === 'hu' ? 'Cím' : lang === 'ro' ? 'Adresă' : 'Address'}</span>
                <div style="display: flex; gap: 0.75rem; align-items: flex-start;">
                    <span style="color: #4f46e5; filter: drop-shadow(0 0 8px rgba(79, 70, 229, 0.4));">📍</span>
                    <span style="color: white; font-weight: 500;">{t('contact.address')}</span>
                </div>
            </div>
            
            <div class="footer-contact-card">
                <span style="font-size: 0.8rem; color: #64748b; display: block; margin-bottom: 0.5rem; text-transform: uppercase; letter-spacing: 0.05em;">Email</span>
                <div style="display: flex; gap: 0.75rem; align-items: center;">
                    <span style="color: #ec4899; filter: drop-shadow(0 0 8px rgba(236, 72, 153, 0.4));">✉️</span>
                    <a href={`mailto:${t('contact.email')}`} style="color: white; text-decoration: none; font-weight: 500;">{t('contact.email')}</a>
                </div>
            </div>

            <div class="footer-contact-card">
                <span style="font-size: 0.8rem; color: #64748b; display: block; margin-bottom: 0.5rem; text-transform: uppercase; letter-spacing: 0.05em;">{t('contact.president')}</span>
                <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                    <p style="font-weight: 700; color: white; margin: 0;">Kovács Zsolt</p>
                    <a href={`mailto:${t('contact.president_email')}`} style="color: #94a3b8; font-size: 0.9rem; text-decoration: none; transition: color 0.2s;">{t('contact.president_email')}</a>
                </div>
            </div>
        </div>
      </div>
    </div>

    <div style="margin-top: 8rem; padding-top: 2rem; border-top: 1px solid rgba(255,255,255,0.1); display: flex; justify-content: space-between; align-items: center; color: #64748b; font-size: 0.9rem;">
      <p>&copy; {currentYear} {lang === 'hu' ? 'Egy Esély a Közösségért Egyesület' : lang === 'ro' ? 'Asociația O Șansă Pentru Comunitate' : 'A Chance for the Community Association'}. Built with passion.</p>
      <div style="display: flex; gap: 2rem;">
          <a href="https://www.facebook.com/ospcom" target="_blank" rel="noopener noreferrer" style="color: inherit; text-decoration: none;">Facebook</a>
          <a href="https://www.instagram.com/ospc.egyesulet/" target="_blank" rel="noopener noreferrer" style="color: inherit; text-decoration: none;">Instagram</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-link-item {
    color: #94a3b8;
    text-decoration: none;
    transition: color 0.2s;
    font-weight: 500;
  }
  .footer-link-item:hover {
    color: white;
  }
  .footer-cookie-btn {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    font-size: inherit;
    font-family: inherit;
    font-weight: 500;
  }
  .footer-contact-card {
    background: rgba(255, 255, 255, 0.03);
    padding: 1.25rem;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: all 0.3s ease;
  }
  .footer-contact-card:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.15);
    transform: translateY(-2px);
  }
  @media (max-width: 1024px) {
    .footer-grid { grid-template-columns: 1fr !important; gap: 4rem; }
  }
</style>

<script>
  document.getElementById('cookie-settings-btn')?.addEventListener('click', () => {
    localStorage.removeItem('ospc_cookie_consent');
    const banner = document.getElementById('cookie-banner');
    if (banner) banner.style.display = 'block';
    window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' });
  });
</script>
