---
import { useTranslations } from '../i18n/utils';
const { lang } = Astro.props;
const t = useTranslations(lang as any);
---

<section id="news" class="reveal" style="padding: 6rem 0;">
  <div class="container">
     <div class="section-title">
      <h2>{t('nav.news')}</h2>
      <p>{lang === 'hu' ? 'Friss hírek közvetlenül a Facebook oldalunkról' : lang === 'ro' ? 'Ultimele noutăți direct de pe pagina noastră de Facebook' : 'Latest news directly from our Facebook page'}</p>
    </div>
    <div id="news-feed-container" class="news-grid">
      <!-- Loading state -->
      <div class="loading-placeholder" style="grid-column: 1/-1; text-align: center; padding: 4rem;">
        <div class="spinner"></div>
        <p style="margin-top: 1rem; color: #64748b;">{lang === 'hu' ? 'Hírek betöltése...' : lang === 'ro' ? 'Se încarcă noutățile...' : 'Loading news...'}</p>
      </div>
    </div>
    
    <div id="all-news-btn-container" style="text-align: center; margin-top: 4rem; display: none;">
      <a href="https://www.facebook.com/ospcom" target="_blank" class="btn btn-outline" style="border: 2px solid #000; padding: 1rem 2rem; font-weight: 700; border-radius: 12px; text-decoration: none; color: #000; display: inline-flex; align-items: center; gap: 0.5rem; transition: all 0.2s;">
        {lang === 'hu' ? 'Összes hír a Facebookon' : lang === 'ro' ? 'Toate știrile pe Facebook' : 'All news on Facebook'}
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
      </a>
    </div>
  </div>
</section>

<script is:inline define:vars={{ lang }}>
  async function fetchNews() {
    const container = document.getElementById('news-feed-container');
    const btnContainer = document.getElementById('all-news-btn-container');
    if (!container) return;

    try {
      console.log('Fetching news from Behold...');
      const response = await fetch('https://feeds.behold.so/hJxfbN54x5TAbodaKbaP');
      const jsonData = await response.json();
      
      const posts = jsonData.posts || jsonData;
      if (!posts || !Array.isArray(posts)) throw new Error('Invalid data structure');

      container.innerHTML = '';
      if (btnContainer) btnContainer.style.display = 'block';

      posts.slice(0, 6).forEach(post => {
        const date = new Date(post.timestamp);
        const imageUrl = post.sizes?.large?.mediaUrl || post.mediaUrl;
        
        const card = document.createElement('div');
        card.className = 'news-card';
        
        const fullCaption = post.caption || '';
        const previewCaption = fullCaption.length > 150 ? fullCaption.substring(0, 150) + '...' : fullCaption;
        const lines = fullCaption.split('\n');
        const title = lines[0].length < 60 ? lines[0] : (lang === 'hu' ? 'Friss hír' : lang === 'ro' ? 'Știri noi' : 'Latest News');

        card.innerHTML = `
          <div class="news-image-container">
            <img src="${imageUrl}" alt="${title}" class="news-img" loading="lazy" onerror="this.src='https://picsum.photos/600/400?grayscale&blur=2'">
            <div class="image-overlay"></div>
            <div class="news-date-badge">
              <span class="day">${date.getDate()}</span>
              <span class="month">${date.toLocaleDateString(lang === 'hu' ? 'hu-HU' : lang === 'ro' ? 'ro-RO' : 'en-US', { month: 'short' }).toUpperCase()}</span>
            </div>
          </div>
          <div class="news-content">
            <h3 class="news-card-title">${title}</h3>
            <p class="news-card-excerpt">${previewCaption}</p>
            <div class="news-card-footer">
              <a href="${post.permalink}" target="_blank" class="news-action-btn">
                <span>${lang === 'hu' ? 'Megnyitás Facebookon' : lang === 'ro' ? 'Vezi pe Facebook' : 'Open on Facebook'}</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
              </a>
            </div>
          </div>
        `;
        container.appendChild(card);
      });
    } catch (error) {
      console.error('Error fetching news:', error);
      container.innerHTML = `
        <div style="grid-column: 1/-1; text-align: center; padding: 4rem; background: #fff1f2; border-radius: 24px; border: 1px solid #fecaca;">
          <svg style="margin-bottom: 1rem; color: #ef4444;" xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="8" x2="12" y2="12"></line></svg>
          <p style="color: #991b1b; font-weight: 600;">${lang === 'hu' ? 'Hoppá! Nem sikerült betölteni a híreket.' : lang === 'ro' ? 'Eroare la încărcarea noutăților.' : 'Oops! Failed to load news.'}</p>
        </div>
      `;
      if (btnContainer) btnContainer.style.display = 'block';
    }
  }

  document.addEventListener('DOMContentLoaded', fetchNews);
  document.addEventListener('astro:page-load', fetchNews);
</script>

<style is:global>
  .news-grid {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3rem;
    margin-top: 3rem;
    width: 100%;
    padding: 0 1rem;
  }
  .news-card {
    background: white;
    border-radius: 1.5rem;
    overflow: hidden;
    border: 1px solid #f1f5f9;
    box-shadow: 0 1rem 2rem -1rem rgba(0, 0, 0, 0.1);
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 40rem;
    position: relative;
    max-height: 85vh;
  }
  .news-image-container {
    width: 100%;
    height: 20rem;
    position: relative;
    overflow: hidden;
    background-color: #f1f5f9;
  }
  .news-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .news-content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    overflow: hidden;
  }
  .news-card-title {
    font-size: 1.25rem;
    margin-bottom: 0.75rem;
    line-height: 1.3;
    color: #1e293b;
    font-weight: 800;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .news-card-excerpt {
    color: #475569;
    line-height: 1.5;
    margin-bottom: 1.25rem;
    font-size: 0.95rem;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
  }
  .image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.2) 0%, transparent 60%);
    pointer-events: none;
  }
  .news-date-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    padding: 0.5rem;
    border-radius: 0.75rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 3rem;
    box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.1);
    z-index: 10;
  }
  .news-date-badge .day {
    font-size: 1.1rem;
    font-weight: 800;
    color: #4f46e5;
    line-height: 1;
  }
  .news-date-badge .month {
    font-size: 0.6rem;
    font-weight: 800;
    color: #64748b;
    margin-top: 0.15rem;
    text-transform: uppercase;
  }
  .news-card-footer {
    padding-top: 1rem;
    border-top: 1px solid #f1f5f9;
    margin-top: auto;
  }
  .news-action-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    color: #4f46e5;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.85rem;
  }

  @media (max-width: 640px) {
    .news-grid { gap: 2rem; margin-top: 2rem; }
    .news-card { 
      max-width: 92vw; 
      border-radius: 1.25rem;
    }
    .news-image-container { 
      height: 350px !important; 
    }
    .news-content { padding: 1.25rem; }
    .news-card-title { font-size: 1.1rem; }
    .news-card-excerpt { -webkit-line-clamp: 2; }
  }
</style>
