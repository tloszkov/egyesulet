---
import { useTranslations } from '../i18n/utils';
const { lang } = Astro.props;
const t = useTranslations(lang as any);
---

<section id="news" class="reveal" style="padding: 6rem 0;">
  <div class="container">
    <div class="section-title">
      <h2>{t('nav.news')}</h2>
      <p>{lang === 'hu' ? 'Friss hírek közvetlenül a Facebook oldalunkról' : lang === 'ro' ? 'Ultimele noutăți direct de pe pagina noastră de Facebook' : 'Latest news directly from our Facebook page'}</p>
    </div>

    <!-- Juicer.io Facebook Feed -->
    <div id="juicer-feed-asocia-ia-ospc-egyesulet" style="margin-top: 3rem;"></div>

    <div style="text-align: center; margin-top: 3rem;">
      <a href="https://www.facebook.com/ospcom" target="_blank" class="btn btn-outline" style="border: 2px solid #000; padding: 1rem 2rem; font-weight: 700; border-radius: 12px; text-decoration: none; color: #000; display: inline-flex; align-items: center; gap: 0.5rem; transition: all 0.2s;">
        {lang === 'hu' ? 'Összes hír a Facebookon' : lang === 'ro' ? 'Toate știrile pe Facebook' : 'All news on Facebook'}
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
      </a>
    </div>
  </div>
</section>

<script type="text/javascript" src="https://www.juicer.io/embed/asocia-ia-ospc-egyesulet/embed-code.js" async defer></script>
