---
const { lang } = Astro.props;

const title = lang === 'hu' ? 'Partnereink & Támogatóink' : lang === 'ro' ? 'Partenerii & Susținătorii Noștri' : 'Our Partners & Supporters';
const subtitle = lang === 'hu' ? 'Köszönet mindazoknak, akik lehetővé teszik munkánkat' : lang === 'ro' ? 'Mulțumim tuturor celor care fac posibilă activitatea noastră' : 'Thank you to all who make our work possible';

const partners = [
  {
    name: lang === 'hu' ? 'Székelykeresztúr Polgármesteri Hivatala' : lang === 'ro' ? 'Primăria Cristuru Secuiesc' : 'Cristuru Secuiesc Town Hall',
    initials: 'PH',
    url: '#',
    category: lang === 'hu' ? 'Önkormányzat' : lang === 'ro' ? 'Primărie' : 'Municipality',
    color: '#4f46e5',
  },
  {
    name: lang === 'hu' ? 'Hargita Megye Tanácsa' : lang === 'ro' ? 'Consiliul Județean Harghita' : 'Harghita County Council',
    initials: 'HM',
    url: '#',
    category: lang === 'hu' ? 'Megyei Tanács' : lang === 'ro' ? 'Consiliul Județean' : 'County Council',
    color: '#ec4899',
  },
  {
    name: lang === 'hu' ? 'Székelykeresztúri Városi Könyvtár' : lang === 'ro' ? 'Biblioteca Orășenească Cristuru Secuiesc' : 'Cristuru Secuiesc City Library',
    initials: 'VK',
    url: '#',
    category: lang === 'hu' ? 'Kulturális intézmény' : lang === 'ro' ? 'Instituție culturală' : 'Cultural Institution',
    color: '#06b6d4',
  },
  {
    name: lang === 'hu' ? 'Molnár István Székelykeresztúri Múzeum' : lang === 'ro' ? 'Muzeul Molnár István Cristuru Secuiesc' : 'Molnár István Museum Cristuru Secuiesc',
    initials: 'MÍM',
    url: '#',
    category: lang === 'hu' ? 'Múzeum' : lang === 'ro' ? 'Muzeu' : 'Museum',
    color: '#f59e0b',
  },
  {
    name: lang === 'hu' ? 'Székelyudvarhelyi Közösségi Alapítvány' : lang === 'ro' ? 'Fundația Comunitară Odorheiu Secuiesc' : 'Odorheiu Secuiesc Community Foundation',
    initials: 'SKA',
    url: '#',
    category: lang === 'hu' ? 'Alapítvány' : lang === 'ro' ? 'Fundație' : 'Foundation',
    color: '#10b981',
  },
  {
    name: 'Bethlen Gábor Alapkezelő Zrt.',
    initials: 'BGA',
    url: '#',
    category: lang === 'hu' ? 'Alapkezelő' : lang === 'ro' ? 'Fond de finanțare' : 'Funding Body',
    color: '#8b5cf6',
  },
  {
    name: 'Communitas Alapítvány',
    initials: 'CA',
    url: '#',
    category: lang === 'hu' ? 'Alapítvány' : lang === 'ro' ? 'Fundație' : 'Foundation',
    color: '#ef4444',
  },
];
---

<section class="partners-section reveal">
  <div class="container">
    <div class="section-title">
      <h2>{title}</h2>
      <p>{subtitle}</p>
    </div>

    <div class="partners-grid">
      {partners.map(partner => (
        <a href={partner.url} class="partner-card" target={partner.url !== '#' ? '_blank' : '_self'} rel="noopener noreferrer">
          <div class="partner-logo-wrap">
            {/* Ha van logo: <img src={partner.logo} alt={partner.name} /> */}
            <div class="partner-initials" style={`background: ${partner.color}18; color: ${partner.color};`}>
              {partner.initials}
            </div>
          </div>
          <div class="partner-info">
            <span class="partner-name">{partner.name}</span>
            <span class="partner-category">{partner.category}</span>
          </div>
        </a>
      ))}
    </div>

    <p class="partners-cta">
      {lang === 'hu' ? 'Csatlakoznál partnerként?' : lang === 'ro' ? 'Vrei să devii partener?' : 'Want to become a partner?'}
      {' '}
      <a href={lang === 'ro' ? '/contact' : lang === 'hu' ? '/hu/kapcsolat' : '/en/contact'}>
        {lang === 'hu' ? 'Lépj velünk kapcsolatba' : lang === 'ro' ? 'Contactează-ne' : 'Contact us'}
      </a>
    </p>
  </div>
</section>

<style>
  .partners-section {
    padding: 6rem 0;
    background: var(--bg-soft);
  }

  .partners-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .partner-card {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.5rem;
    background: white;
    border-radius: 16px;
    border: 1px solid #f1f5f9;
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    transition: all 0.25s;
  }

  .partner-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: #e2e8f0;
  }

  .partner-logo-wrap {
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .partner-logo-wrap img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .partner-initials {
    width: 56px;
    height: 56px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 1.1rem;
    letter-spacing: -0.02em;
  }

  .partner-info {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  .partner-name {
    font-weight: 700;
    color: #1e293b;
    font-size: 0.875rem;
    line-height: 1.3;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .partner-category {
    font-size: 0.75rem;
    color: #94a3b8;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .partners-cta {
    text-align: center;
    color: #64748b;
    font-size: 0.95rem;
  }

  .partners-cta a {
    color: var(--primary);
    font-weight: 700;
    text-decoration: none;
  }

  .partners-cta a:hover { text-decoration: underline; }

  @media (max-width: 1024px) {
    .partners-grid { grid-template-columns: repeat(3, 1fr); }
  }

  @media (max-width: 768px) {
    .partners-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 480px) {
    .partners-grid { grid-template-columns: 1fr; }
  }
</style>
