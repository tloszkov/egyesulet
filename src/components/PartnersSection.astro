---
const { lang } = Astro.props;

const title = lang === 'hu' ? 'Partnereink & Támogatóink' : lang === 'ro' ? 'Partenerii & Susținătorii Noștri' : 'Our Partners & Supporters';
const subtitle = lang === 'hu' ? 'Köszönet mindazoknak, akik lehetővé teszik munkánkat' : lang === 'ro' ? 'Mulțumim tuturor celor care fac posibilă activitatea noastră' : 'Thank you to all who make our work possible';

const partners = [
  {
    name: lang === 'hu' ? 'Székelykeresztúr Polgármesteri Hivatala' : lang === 'ro' ? 'Primăria Cristuru Secuiesc' : 'Cristuru Secuiesc Town Hall',
    logo: '/partners/polgarmesteri.png',
    url: '#',
    category: lang === 'hu' ? 'Önkormányzat' : lang === 'ro' ? 'Primărie' : 'Municipality',
    darkBg: false,
  },
  {
    name: lang === 'hu' ? 'Hargita Megye Tanácsa' : lang === 'ro' ? 'Consiliul Județean Harghita' : 'Harghita County Council',
    logo: '/partners/hargita.png',
    url: '#',
    category: lang === 'hu' ? 'Megyei Tanács' : lang === 'ro' ? 'Consiliul Județean' : 'County Council',
    darkBg: true,
  },
  {
    name: lang === 'hu' ? 'Székelykeresztúri Városi Könyvtár' : lang === 'ro' ? 'Biblioteca Orășenească Cristuru Secuiesc' : 'Cristuru Secuiesc City Library',
    logo: null,
    initials: 'VK',
    color: '#06b6d4',
    url: '#',
    category: lang === 'hu' ? 'Kulturális intézmény' : lang === 'ro' ? 'Instituție culturală' : 'Cultural Institution',
    darkBg: false,
  },
  {
    name: lang === 'hu' ? 'Molnár István Múzeum' : lang === 'ro' ? 'Muzeul Molnár István' : 'Molnár István Museum',
    logo: '/partners/molnar-istvan.png',
    url: '#',
    category: lang === 'hu' ? 'Múzeum' : lang === 'ro' ? 'Muzeu' : 'Museum',
    darkBg: false,
  },
  {
    name: lang === 'hu' ? 'Székelyudvarhelyi Közösségi Alapítvány' : lang === 'ro' ? 'Fundația Comunitară Odorheiu Secuiesc' : 'Odorheiu Secuiesc Community Foundation',
    logo: '/partners/szka.jpg',
    url: '#',
    category: lang === 'hu' ? 'Alapítvány' : lang === 'ro' ? 'Fundație' : 'Foundation',
    darkBg: false,
  },
  {
    name: 'Bethlen Gábor Alapkezelő Zrt.',
    logo: '/partners/bga.jpg',
    url: '#',
    category: lang === 'hu' ? 'Alapkezelő' : lang === 'ro' ? 'Fond de finanțare' : 'Funding Body',
    darkBg: false,
  },
  {
    name: 'Communitas Alapítvány',
    logo: '/partners/communitas.png',
    url: '#',
    category: lang === 'hu' ? 'Alapítvány' : lang === 'ro' ? 'Fundație' : 'Foundation',
    darkBg: false,
  },
];
---

<section class="partners-section reveal">
  <div class="container">
    <div class="section-title">
      <h2>{title}</h2>
      <p>{subtitle}</p>
    </div>

    <div class="partners-grid">
      {partners.map(partner => (
        <a href={partner.url} class="partner-card" target={partner.url !== '#' ? '_blank' : '_self'} rel="noopener noreferrer">
          <div class={`partner-logo-wrap ${partner.darkBg ? 'dark-bg' : ''}`}>
            {partner.logo ? (
              <img src={partner.logo} alt={partner.name} loading="lazy" />
            ) : (
              <div class="partner-initials" style={`background: ${(partner as any).color}18; color: ${(partner as any).color};`}>
                {(partner as any).initials}
              </div>
            )}
          </div>
          <div class="partner-info">
            <span class="partner-category">{partner.category}</span>
            <span class="partner-name">{partner.name}</span>
          </div>
        </a>
      ))}
    </div>

    <p class="partners-cta">
      {lang === 'hu' ? 'Csatlakoznál partnerként?' : lang === 'ro' ? 'Vrei să devii partener?' : 'Want to become a partner?'}
      {' '}
      <a href={lang === 'ro' ? '/contact' : lang === 'hu' ? '/hu/kapcsolat' : '/en/contact'}>
        {lang === 'hu' ? 'Lépj velünk kapcsolatba' : lang === 'ro' ? 'Contactează-ne' : 'Contact us'}
      </a>
    </p>
  </div>
</section>

<style>
  .partners-section {
    padding: 6rem 0;
    background: var(--bg-soft);
  }

  .partners-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
    margin-bottom: 3rem;
  }

  .partner-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding: 1.75rem 1.25rem;
    background: white;
    border-radius: 20px;
    border: 1px solid #f1f5f9;
    box-shadow: var(--shadow-sm);
    text-decoration: none;
    transition: all 0.25s;
    text-align: center;
  }

  .partner-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: #e2e8f0;
  }

  .partner-logo-wrap {
    width: 100%;
    height: 90px;
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f8fafc;
    padding: 0.5rem;
  }

  .partner-logo-wrap.dark-bg {
    background: #1e293b;
  }

  .partner-logo-wrap img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .partner-initials {
    width: 64px;
    height: 64px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 1.1rem;
  }

  .partner-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    width: 100%;
  }

  .partner-category {
    font-size: 0.7rem;
    color: #94a3b8;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .partner-name {
    font-weight: 700;
    color: #1e293b;
    font-size: 0.85rem;
    line-height: 1.35;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .partners-cta {
    text-align: center;
    color: #64748b;
    font-size: 0.95rem;
  }

  .partners-cta a {
    color: var(--primary);
    font-weight: 700;
    text-decoration: none;
  }
  .partners-cta a:hover { text-decoration: underline; }

  @media (max-width: 1024px) {
    .partners-grid { grid-template-columns: repeat(3, 1fr); }
  }

  @media (max-width: 640px) {
    .partners-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
