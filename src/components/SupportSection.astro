---
import { useTranslations } from '../i18n/utils';
const { lang } = Astro.props;
const t = useTranslations(lang as any);
---

<section id="support" style="background: var(--bg-soft); padding: 6rem 0;">
  <div class="container">
    <div class="section-title">
      <h2>{t('hero.cta_support')}</h2>
      <div style="width: 60px; height: 4px; background: var(--color-secondary); margin: 0 auto; border-radius: 2px;"></div>
    </div>
    
    <div class="grid-2" style="margin-top: 3rem;">
      <div class="card" style="padding: 3rem; text-align: center;">
        <h3 style="margin-bottom: 1.5rem;">2% / 3.5% Din Impozit</h3>
        <p style="margin-bottom: 2rem;">Sprijină activitatea noastră redirecționând o parte din impozitul pe venit. Este gratuit pentru tine, dar vital pentru noi!</p>
        <a href="#" class="btn btn-primary">Descarcă Formularul</a>
      </div>
      
      <div class="card" style="padding: 3rem; text-align: center;">
        <h3 style="margin-bottom: 1.5rem;">Donație Directă</h3>
        <p style="margin-bottom: 1rem;">Poți susține proiectele noastre prin transfer bancar:</p>
        <div style="background: #f8fafc; padding: 1.5rem; border-radius: 12px; font-family: monospace; text-align: left;">
          <p><strong>Titular:</strong> Asociația O Șansă Pentru Comunitate</p>
          <p><strong>IBAN:</strong> RO00 XXXX XXXX XXXX XXXX XXXX</p>
          <p><strong>Banca:</strong> BCR</p>
          <p><strong>SWIFT:</strong> RNCB ROBU</p>
        </div>
      </div>
    </div>
  </div>
</section>
