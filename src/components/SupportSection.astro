---
import { useTranslations } from '../i18n/utils';
const { lang } = Astro.props;
const t = useTranslations(lang as any);

const isRo = lang === 'ro';
const isHu = lang === 'hu';
const isEn = lang === 'en';
---

<section id="support-premium">
  <!-- Why Support Us - High End Pitch -->
  <div class="why-support">
    <div class="container pitch-container">
      <div class="pitch-content reveal">
        <span class="impact-badge">{isHu ? 'Hatásunk' : 'Our Impact'}</span>
        <h2>{t('support.why_title')}</h2>
        <p>{t('support.why_text')}</p>
        
        <div class="trust-indicators">
            <div class="trust-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="check"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span>{isHu ? '100% Átláthatóság' : '100% Transparent'}</span>
            </div>
            <div class="trust-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="check"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span>{isHu ? 'Helyi Hatás' : 'Direct Local Impact'}</span>
            </div>
        </div>
      </div>
      
      <!-- Premium UI Controls -->
      <div class="ui-pitch reveal">
          <div class="floating-controls">
              <div class="ctrl-group">
                  <label>{isHu ? 'Típus' : isRo ? 'Tip' : 'Type'}</label>
                  <div class="pill-group" id="type-selector">
                      <button data-type="card">{t('support.method_card')}</button>
                      <button data-type="transfer">{t('support.method_transfer')}</button>
                      <button class="active" data-type="tax">{t('support.method_tax')}</button>
                  </div>
              </div>
              <div class="ctrl-group animate-expand" id="currency-group">
                  <label>{isHu ? 'Pénznem' : isRo ? 'Monedă' : 'Currency'}</label>
                  <div class="pill-group" id="currency-selector">
                      <button data-currency="HUF">HUF</button>
                      <button data-currency="EUR">EUR</button>
                      <button class="active" data-currency="RON">RON</button>
                  </div>
              </div>
          </div>
      </div>
    </div>
  </div>

  <!-- Form Section - Modern "Linear" style -->
  <div class="form-wrapper">
    <div class="container container-sm">
      
      <div class="notice-card">
        <p>
            {isHu ? 'Ha az űrlap nem jelenik meg megfelelően, felajánlásod ' : isRo ? 'Dacă formularul nu este afișat corect, poți dona ' : 'If the form is not displayed correctly, you can donate '} 
            <a href="https://redirectioneaza.ro" target="_blank">{isHu ? 'ezen a biztonságos linken' : isRo ? 'prin acest link securizat' : 'via this secure link'}</a> 
            {isHu ? 'is elvégezheted.' : isRo ? ' de asemenea.' : ' as well.'}
        </p>
      </div>

        <div class="saas-form-card reveal">
          <!-- Tax Redirection Form (Original) -->
          <div id="tax-form-content">
            <div class="form-header">
                <div class="org-info">
                    <img src="/logo.png" alt="Logo" class="mini-logo" />
                    <div>
                        <h3>{isEn ? 'A Chance for the Community Association' : isHu ? 'Egy Esély a Közösségért Egyesület' : 'Asociația O Șansă Pentru Comunitate'}</h3>
                        <p>{t('support.form_title')}</p>
                    </div>
                </div>
            </div>
    
            <div class="step-guide">
                <div class="guide-box">
                    {isHu ? 'Kitöltés online → Hitelesítés → Automatikus beküldés az ANAF-hoz.' : isRo ? 'Completează online → Semnează → Depunere automată la ANAF.' : 'Complete online → Sign → Automatic submission to ANAF.'}
                </div>
            </div>
    
            <form class="modern-form" id="support-form">
            <!-- Section 1: Identification -->
            <div class="form-banner">{isRo ? 'Date de identificare a contribuabilului' : isHu ? 'Adózó azonosító adatai' : 'Taxpayer Identification Data'}</div>
            <div class="form-grid">
                <div class="input-group">
                    <label>{isRo ? 'Nume *' : isHu ? 'Vezetéknév *' : 'Last Name *'}</label>
                    <input type="text" placeholder={isEn ? "Ex: Smith" : "Ex: Popescu"} required />
                </div>
                <div class="input-group">
                    <label>{isRo ? 'Prenume *' : isHu ? 'Utónév *' : 'First Name *'}</label>
                    <input type="text" placeholder={isEn ? "Ex: John" : "Ex: Ion"} required />
                </div>
                <div class="input-group">
                    <label>{isRo ? 'Inițială Tată (opțional)' : isHu ? 'Apa kezdőbetűje (opcionális)' : "Father's Initial (optional)"}</label>
                    <input type="text" placeholder="Ex: A." />
                </div>
                <div class="input-group">
                    <label>CNP / NIF *</label>
                    <input type="text" id="cnp-input" placeholder="1XXXXXXXXXXXX" maxlength="13" required />
                    <span id="cnp-error" class="error-msg" style="display: none; color: #ef4444; font-size: 0.75rem; font-weight: 600; margin-top: 0.25rem;"></span>
                </div>
                <div class="input-group">
                    <label>Email *</label>
                    <input type="email" placeholder="email@example.com" required />
                </div>
                <div class="input-group">
                    <label>{isRo ? 'Telefon (opțional)' : isHu ? 'Telefonszám (opcionális)' : 'Phone (optional)'}</label>
                    <input type="tel" placeholder="07xx xxx xxx" />
                </div>
            </div>

            <!-- Section 2: Address -->
            <div class="form-banner">{isRo ? 'Adresa de domiciliu (conform actului de identitate)' : isHu ? 'Lakcím (a személyi igazolvány szerint)' : 'Home Address (per identity document)'}</div>
            <div class="form-grid">
                <div class="input-group">
                    <label>{isRo ? 'Județ *' : isHu ? 'Megye *' : 'County *'}</label>
                    <select id="county-select" required>
                        <option value="">{isRo ? 'Selectează Județ...' : isHu ? 'Válassz megyét...' : 'Select County...'}</option>
                    </select>
                </div>
                <div class="input-group">
                    <label>{isRo ? 'Localitate *' : isHu ? 'Település *' : 'Locality *'}</label>
                    <select id="city-select" required>
                        <option value="">{isRo ? 'Előbb válassz megyét...' : isHu ? 'Előbb válassz megyét...' : 'Select county first...'}</option>
                    </select>
                </div>
                <div class="input-group">
                    <label>{isRo ? 'Cod poștal' : isHu ? 'Irányítószám' : 'Postal Code'}</label>
                    <input type="text" placeholder="XXXXXX" />
                </div>
                <div class="input-group">
                    <label>{isRo ? 'Strada *' : isHu ? 'Utca *' : 'Street *'}</label>
                    <input type="text" placeholder="..." required />
                </div>
                <div class="input-group mini">
                    <label>{isRo ? 'Nr. *' : isHu ? 'Házszám *' : 'No. *'}</label>
                    <input type="text" placeholder="1" required />
                </div>
                <div class="input-group mini">
                    <label>Bloc</label>
                    <input type="text" placeholder="A1" />
                </div>
                <div class="input-group mini">
                    <label>Scara</label>
                    <input type="text" placeholder="A" />
                </div>
                <div class="input-group mini">
                    <label>Etaj</label>
                    <input type="text" placeholder="1" />
                </div>
                <div class="input-group mini">
                    <label>Apart.</label>
                    <input type="text" placeholder="12" />
                </div>
            </div>

            <!-- Section 3: Period -->
            <div class="form-banner">{isRo ? 'Perioada redirecționării' : isHu ? 'Felajánlás időtartama' : 'Redirection Period'}</div>
            <div class="period-selection">
                <label class="radio-card">
                    <input type="radio" name="period" value="1" checked />
                    <span class="radio-content">
                        <span class="radio-check"></span>
                        <span class="radio-label">{isRo ? 'Un an' : isHu ? 'Egy év' : 'One year'}</span>
                    </span>
                </label>
                <label class="radio-card">
                    <input type="radio" name="period" value="2" />
                    <span class="radio-content">
                        <span class="radio-check"></span>
                        <span class="radio-label">{isRo ? 'Doi ani' : isHu ? 'Két év' : 'Two years'}</span>
                    </span>
                </label>
            </div>

            <!-- Section 4: Signature -->
            <div class="form-banner">{isRo ? 'Semnătură olograf *' : isHu ? 'Saját kezű aláírás *' : 'Holographic Signature *'}</div>
            <div class="signature-block">
                <p class="instr">{isRo ? '(Semnează olograf / de mână cât mai centrat pe linie pentru o încadrare bună. Folosește touchscreen-ul de pe telefon, tabletă, laptop etc.)' : isHu ? '(Írd alá saját kezűleg, próbálj a vonal közepére írni. Használd a telefonod, tableted vagy laptopod érintőképernyőjét.)' : '(Sign by hand as centered as possible on the line for good framing. Use the touchscreen on your phone, tablet, laptop, etc.)'}</p>
                
                <div class="consent-block" style="margin: 2rem 0;">
                    <label class="checkbox-container">
                        <input type="checkbox" required />
                        <span class="checkmark"></span>
                        <span class="label-text">{isRo ? 'Sunt de acord ca datele de identificare (nume, prenume și cod numeric personal/număr de identificare fiscală), precum și suma direcționată să fie comunicate entității beneficiare.' : isHu ? 'Hozzájárulok, hogy az azonosító adataimat (vezetéknév, utónév és személyi szám/adószám), valamint a felajánlott összeget közöljék a kedvezményezett szervezettel.' : 'I agree that the identification data (last name, first name, and personal numeric code/tax identification number), as well as the directed amount, be communicated to the beneficiary entity.'}</span>
                    </label>
                </div>

                <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 1rem;">
                    <span style="font-weight: 700; font-size: 0.9rem;">{isRo ? 'Semnează în chenar' : isHu ? 'Írj a keretbe' : 'Sign in the box'}</span>
                    <button type="button" id="clear-sig" class="btn-clear-sig">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path></svg>
                        {isRo ? 'Semnătură nouă' : isHu ? 'Új aláírás' : 'New Signature'}
                    </button>
                </div>
                <div class="canvas-wrapper">
                    <canvas id="sig-canvas" height="300"></canvas>
                    <div class="sig-line"></div>
                </div>
            </div>

            <div class="form-footer">
                <button type="submit" class="btn btn-primary btn-block">
                    {isRo ? 'TRIMITE FORMULARUL' : isHu ? 'ŰRLAP BEKÜLDÉSE' : 'SUBMIT FORM'}
                </button>
            </div>
        </form>
      </div>

      <!-- Donation Form Content (New) -->
      <div id="donation-form-content" style="display: none;">
        <div class="form-header">
            <div class="org-info" style="flex-direction: column; text-align: center; gap: 1rem;">
                <img src="/logo.png" alt="Logo" class="mini-logo" />
                <h3 style="font-size: 1.25rem;">{isEn ? 'A Chance for the Community Association' : isHu ? 'Egy Esély a Közösségért Egyesület' : 'Asociația O Șansă Pentru Comunitate'}</h3>
                <div class="donation-badge-header">{t('support.donation_title')}</div>
            </div>
        </div>

        <form class="modern-form" id="donation-form">
            <!-- Donation Type Toggle -->
            <div class="donation-toggle-wrapper">
                <span class={lang === 'hu' ? 'active' : ''}>{t('support.recurring')}</span>
                <label class="switch">
                    <input type="checkbox" id="donation-recurring-toggle">
                    <span class="slider round"></span>
                </label>
                <span>{t('support.one_time')}</span>
            </div>

            <!-- Amount Selection -->
            <div class="amount-selection-grid" id="amount-options">
                <button type="button" class="amount-btn" data-amount="28">28 <span class="curr-label">RON</span></button>
                <button type="button" class="amount-btn active" data-amount="56">56 <span class="curr-label">RON</span></button>
                <button type="button" class="amount-btn" data-amount="140">140 <span class="curr-label">RON</span></button>
                <div class="custom-amount-input">
                    <input type="number" id="custom-amount" placeholder={t('support.custom_amount')} />
                    <span class="curr-suffix">RON</span>
                </div>
            </div>

            <div class="form-grid" style="margin-top: 2rem;">
                <div class="input-group full">
                    <label>{t('support.email_label')}</label>
                    <input type="email" placeholder="email@example.com" required />
                </div>
                <div class="input-group">
                    <label>{t('support.last_name')}</label>
                    <input type="text" placeholder="" required />
                </div>
                <div class="input-group">
                    <label>{t('support.first_name')}</label>
                    <input type="text" placeholder="" required />
                </div>
            </div>

            <div class="consent-block" style="margin: 2rem 0;">
                <label class="checkbox-container">
                    <input type="checkbox" required />
                    <span class="checkmark"></span>
                    <span class="label-text">{t('support.terms_1')}</span>
                </label>
                <label class="checkbox-container">
                    <input type="checkbox" required />
                    <span class="checkmark"></span>
                    <span class="label-text">{t('support.terms_2')}</span>
                </label>
            </div>

            <div class="form-footer">
                <button type="submit" class="btn btn-primary btn-block" style="background: #fbbf24; color: #000; font-weight: 800; border: 2px solid #000; box-shadow: 4px 4px 0px 0px #000;">
                    {t('support.submit_donation')}
                </button>
            </div>
        </form>
      </div>

      <!-- Bank Transfer Content (New) -->
      <div id="transfer-form-content" style="display: none;">
        <div class="form-header">
            <div class="org-info" style="flex-direction: column; text-align: center; gap: 1rem;">
                <img src="/logo.png" alt="Logo" class="mini-logo" />
                <h3 style="font-size: 1.25rem;">{isEn ? 'A Chance for the Community Association' : isHu ? 'Egy Esély a Közösségért Egyesület' : 'Asociația O Șansă Pentru Comunitate'}</h3>
                <div class="donation-badge-header">{t('support.transfer_details')}</div>
            </div>
        </div>

        <div class="bank-info-card">
            <div class="bank-row">
                <span class="bank-label">{t('support.beneficiary')}:</span>
                <span class="bank-value">Asociația "O șansă pentru comunitate"</span>
            </div>
            <div class="bank-row">
                <span class="bank-label">{t('support.iban')}:</span>
                <span class="bank-value iban" id="bank-iban">RO10 BTRL RONC RT0T 15E1 BE01</span>
            </div>
            <div class="bank-row">
                <span class="bank-label">{t('support.bank_name')}:</span>
                <span class="bank-value">Banca Transilvania</span>
            </div>
            <div class="bank-row">
                <span class="bank-label">{t('support.transfer_note')}:</span>
                <span class="bank-value highlight">{t('support.transfer_note_val')}</span>
            </div>
        </div>

        <div class="transfer-help-text">
            {t('support.transfer_help')}
        </div>
      </div>
     </div>
    </div>
  </div>
</section>

<script>
    const canvas = document.getElementById('sig-canvas') as HTMLCanvasElement;
    const clearBtn = document.getElementById('clear-sig');
    const countySelect = document.getElementById('county-select') as HTMLSelectElement;
    const citySelect = document.getElementById('city-select') as HTMLSelectElement;

    let allLocalities: any[] = [];

    const loadLocalities = async () => {
        try {
            const response = await fetch('/localitati.json');
            allLocalities = await response.json();
            console.log('Localities loaded:', allLocalities.length);
            populateCounties();
        } catch (error) {
            console.error('Failed to load localities:', error);
        }
    };

    const populateCounties = () => {
        if (!countySelect) return;
        
        // Get unique counties (auto code and name)
        const countiesMap = new Map();
        allLocalities.forEach(loc => {
            if (!countiesMap.has(loc.auto)) {
                countiesMap.set(loc.auto, loc.judet);
            }
        });

        const sortedCounties = Array.from(countiesMap.entries()).sort((a, b) => a[1].localeCompare(b[1]));
        
        // Keep the first placeholder option
        const placeholder = countySelect.options[0];
        countySelect.innerHTML = '';
        countySelect.appendChild(placeholder);

        sortedCounties.forEach(([code, name]) => {
            const opt = document.createElement('option');
            opt.value = code;
            opt.textContent = name;
            countySelect.appendChild(opt);
        });
    };

    if (countySelect && citySelect) {
        loadLocalities();

        countySelect.addEventListener('change', () => {
            const countyCode = countySelect.value;
            citySelect.innerHTML = '';
            
            if (!countyCode) {
                const opt = document.createElement('option');
                opt.textContent = document.documentElement.lang === 'hu' ? "Előbb válassz megyét..." : document.documentElement.lang === 'ro' ? "Selectează județul întâi..." : "Select county first...";
                citySelect.appendChild(opt);
                return;
            }

            const filtered = allLocalities
                .filter(loc => loc.auto === countyCode)
                .sort((a, b) => a.diacritice.localeCompare(b.diacritice));

            // Default placeholder
            const placeholder = document.createElement('option');
            placeholder.value = "";
            placeholder.textContent = document.documentElement.lang === 'hu' ? "Válassz települést..." : document.documentElement.lang === 'ro' ? "Selectează localitatea..." : "Select locality...";
            placeholder.disabled = true;
            placeholder.selected = true;
            citySelect.appendChild(placeholder);

            filtered.forEach(loc => {
                const opt = document.createElement('option');
                opt.value = loc.diacritice;
                opt.textContent = loc.diacritice;
                citySelect.appendChild(opt);
            });
        });
    }
    
    if (canvas) {
        const ctx = canvas.getContext('2d');
        let drawing = false;

        // Resize canvas to fill wrapper width
        const resize = () => {
            const rect = canvas.parentElement?.getBoundingClientRect();
            if (rect) {
                canvas.width = rect.width;
            }
        };
        resize();
        window.addEventListener('resize', resize);

        const getPos = (e: MouseEvent | TouchEvent) => {
            const rect = canvas.getBoundingClientRect();
            if (e instanceof MouseEvent) {
                return { x: e.clientX - rect.left, y: e.clientY - rect.top };
            } else {
                return { x: e.touches[0].clientX - rect.left, y: e.touches[0].clientY - rect.top };
            }
        };

        const startDrawing = (e: MouseEvent | TouchEvent) => {
            drawing = true;
            const pos = getPos(e);
            ctx?.beginPath();
            ctx?.moveTo(pos.x, pos.y);
            if (e instanceof TouchEvent) e.preventDefault();
        };

        const draw = (e: MouseEvent | TouchEvent) => {
            if (!drawing || !ctx) return;
            const pos = getPos(e);
            ctx.lineTo(pos.x, pos.y);
            ctx.lineWidth = 2;
            ctx.lineCap = 'round';
            ctx.strokeStyle = '#0f172a';
            ctx.stroke();
            if (e instanceof TouchEvent) e.preventDefault();
        };

        const stopDrawing = () => {
            drawing = false;
        };

        canvas.addEventListener('mousedown', startDrawing);
        canvas.addEventListener('mousemove', draw);
        window.addEventListener('mouseup', stopDrawing);

        canvas.addEventListener('touchstart', startDrawing);
        canvas.addEventListener('touchmove', draw);
        canvas.addEventListener('touchend', stopDrawing);

        clearBtn?.addEventListener('click', () => {
            ctx?.clearRect(0, 0, canvas.width, canvas.height);
        });
    }

    // CNP Validation Logic
    const validateCNP = (cnp: string) => {
        if (!/^\d{13}$/.test(cnp)) return false;
        
        const weights = [2, 7, 9, 1, 4, 6, 3, 5, 8, 2, 7, 9];
        const s = parseInt(cnp[0]);
        if (s === 0 || s === 9) return false; // S must be 1-8

        let sum = 0;
        for (let i = 0; i < 12; i++) {
            sum += parseInt(cnp[i]) * weights[i];
        }

        let remainder = sum % 11;
        const controlDigit = remainder === 10 ? 1 : remainder;

        return controlDigit === parseInt(cnp[12]);
    };

    const form = document.getElementById('support-form') as HTMLFormElement;
    const cnpInput = document.getElementById('cnp-input') as HTMLInputElement;
    const cnpError = document.getElementById('cnp-error') as HTMLElement;

    if (form && cnpInput && cnpError) {
        form.addEventListener('submit', (e) => {
            const cnpVal = cnpInput.value.trim();
            const isValid = validateCNP(cnpVal);

             if (!isValid) {
                e.preventDefault();
                cnpError.textContent = "CNP invalid. Te rugăm să verifici cifrele.";
                if (document.documentElement.lang === 'hu') {
                    cnpError.textContent = "Érvénytelen CNP (személyi szám). Kérjük ellenőrizd a számjegyeket.";
                } else if (document.documentElement.lang === 'en') {
                    cnpError.textContent = "Invalid CNP (personal numeric code). Please check the digits.";
                }
                cnpError.style.display = 'block';
                cnpInput.style.borderColor = "#ef4444";
                cnpInput.focus();
            } else {
                cnpError.style.display = 'none';
                cnpInput.style.borderColor = "";
                // Here we would normally let the form submit or handle via AJAX
                const successMsg = document.documentElement.lang === 'hu' ? "Az űrlap sikeresen érvényesítve!" : document.documentElement.lang === 'ro' ? "Formularul a fost validat cu succes!" : "Form successfully validated!";
                alert(successMsg);
            }
        });

        // Hide error on input
        cnpInput.addEventListener('input', () => {
            cnpError.style.display = 'none';
            cnpInput.style.borderColor = "";
        });
    }

    // --- Donation Switching Logic ---
    const currencySelector = document.getElementById('currency-selector');
    const typeSelector = document.getElementById('type-selector');
    const taxForm = document.getElementById('tax-form-content');
    const donationForm = document.getElementById('donation-form-content');
    const transferForm = document.getElementById('transfer-form-content');
    const currencyGroup = document.getElementById('currency-group');
    
    const updateUIState = () => {
        const activeType = typeSelector?.querySelector('button.active')?.getAttribute('data-type');
        const activeCurrency = currencySelector?.querySelector('button.active')?.getAttribute('data-currency');
        
        // Handle currency selector visibility with premium delay
        if (currencyGroup) {
            if (activeType === 'tax') {
                currencyGroup.classList.remove('show');
            } else {
                // Small delay for the "premium" feel
                setTimeout(() => {
                    currencyGroup.classList.add('show');
                }, 100);
            }
        }

        const forms = [
            { el: taxForm, id: 'tax' },
            { el: donationForm, id: 'donation' },
            { el: transferForm, id: 'transfer' }
        ];

        const targetId = activeType === 'tax' ? 'tax' : (activeType === 'transfer' ? 'transfer' : 'donation');

        forms.forEach(f => {
            if (!f.el) return;
            if (f.id === targetId) {
                f.el.style.display = 'block';
                // Trigger animation in next frame
                requestAnimationFrame(() => {
                    f.el?.classList.add('premium-fade');
                });
            } else {
                f.el.classList.remove('premium-fade');
                // Wait for animation to finish before hiding (optional, keeping it simple for now)
                f.el.style.display = 'none';
            }
        });

        if (activeType === 'transfer') {
            // Update IBAN based on currency
            const ibanEl = document.getElementById('bank-iban');
            if (ibanEl) {
                if (activeCurrency === 'EUR') ibanEl.textContent = 'RO55 BTRL EUR0 RT01 2345 6789';
                else if (activeCurrency === 'HUF') ibanEl.textContent = 'RO99 BTRL HUF0 RT01 9876 5432';
                else ibanEl.textContent = 'RO10 BTRL RONC RT0T 15E1 BE01';
            }
        } else if (activeType !== 'tax') {
            // Update currency labels in donation form
            document.querySelectorAll('.curr-label, .curr-suffix').forEach(el => {
                el.textContent = activeCurrency || 'RON';
            });
            
            // Update amount buttons based on currency
            const amountBtns = document.querySelectorAll('.amount-btn');
            if (amountBtns.length >= 3) {
                if (activeCurrency === 'EUR') {
                    (amountBtns[0] as HTMLElement).innerHTML = `10 <span class="curr-label">EUR</span>`;
                    (amountBtns[1] as HTMLElement).innerHTML = `20 <span class="curr-label">EUR</span>`;
                    (amountBtns[2] as HTMLElement).innerHTML = `50 <span class="curr-label">EUR</span>`;
                    amountBtns[0].setAttribute('data-amount', '10');
                    amountBtns[1].setAttribute('data-amount', '20');
                    amountBtns[2].setAttribute('data-amount', '50');
                } else if (activeCurrency === 'HUF') {
                    (amountBtns[0] as HTMLElement).innerHTML = `5000 <span class="curr-label">HUF</span>`;
                    (amountBtns[1] as HTMLElement).innerHTML = `10000 <span class="curr-label">HUF</span>`;
                    (amountBtns[2] as HTMLElement).innerHTML = `25000 <span class="curr-label">HUF</span>`;
                    amountBtns[0].setAttribute('data-amount', '5000');
                    amountBtns[1].setAttribute('data-amount', '10000');
                    amountBtns[2].setAttribute('data-amount', '25000');
                } else {
                    (amountBtns[0] as HTMLElement).innerHTML = `28 <span class="curr-label">RON</span>`;
                    (amountBtns[1] as HTMLElement).innerHTML = `56 <span class="curr-label">RON</span>`;
                    (amountBtns[2] as HTMLElement).innerHTML = `140 <span class="curr-label">RON</span>`;
                    amountBtns[0].setAttribute('data-amount', '28');
                    amountBtns[1].setAttribute('data-amount', '56');
                    amountBtns[2].setAttribute('data-amount', '140');
                }
            }
        }
    };

    // Initialize state
    updateUIState();

    currencySelector?.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest('button');
        if (!btn) return;
        currencySelector.querySelectorAll('button').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        updateUIState();
    });

    typeSelector?.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest('button');
        if (!btn) return;
        typeSelector.querySelectorAll('button').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        updateUIState();
    });

    // Handle recurring toggle label highlighting
    const recurringToggle = document.getElementById('donation-recurring-toggle') as HTMLInputElement;
    recurringToggle?.addEventListener('change', () => {
        const labels = document.querySelectorAll('.donation-toggle-wrapper span');
        if (labels.length >= 2) {
            if (recurringToggle.checked) {
                labels[0].classList.remove('active');
                labels[1].classList.add('active');
            } else {
                labels[0].classList.add('active');
                labels[1].classList.remove('active');
            }
        }
    });

    // Handle donation amount selection
    const amountOptions = document.getElementById('amount-options');
    amountOptions?.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest('.amount-btn');
        if (!btn) return;
        amountOptions.querySelectorAll('.amount-btn').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        const customInp = document.getElementById('custom-amount') as HTMLInputElement;
        if (customInp) customInp.value = '';
    });

    document.getElementById('custom-amount')?.addEventListener('input', () => {
        amountOptions?.querySelectorAll('.amount-btn').forEach(b => b.classList.remove('active'));
    });

    // Donation form submission
    document.getElementById('donation-form')?.addEventListener('submit', (e) => {
        e.preventDefault();
        const activeCurrency = currencySelector?.querySelector('button.active')?.getAttribute('data-currency');
        const activeBtn = amountOptions?.querySelector('.amount-btn.active');
        const customVal = (document.getElementById('custom-amount') as HTMLInputElement).value;
        const amount = activeBtn ? activeBtn.getAttribute('data-amount') : customVal;
        
        if (!amount) {
            const msg = document.documentElement.lang === 'hu' ? 'Kérjük válasszon vagy adjon meg egy összeget.' : 'Vă rugăm să selectați sau să introduceți o sumă.';
            alert(msg);
            return;
        }

        // Mock redirection to Barion style payment
        const waitMsg = document.documentElement.lang === 'hu' ? 'Redirektálás a biztonságos fizetési oldalra (Barion)...' : 'Redirecționare către plată securizată (Barion)...';
        alert(`${waitMsg}\nÖsszeg: ${amount} ${activeCurrency}`);
        window.location.href = "https://www.barion.com";
    });
</script>

