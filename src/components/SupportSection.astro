---
import { useTranslations } from '../i18n/utils';
const { lang } = Astro.props;
const t = useTranslations(lang as any);

const isRo = lang === 'ro';
const isHu = lang === 'hu';
---

<section id="support-premium">
  <!-- Why Support Us - High End Pitch -->
  <div class="why-support">
    <div class="container pitch-container">
      <div class="pitch-content reveal">
        <span class="impact-badge">{isHu ? 'Hatásunk' : 'Our Impact'}</span>
        <h2>{t('support.why_title')}</h2>
        <p>{t('support.why_text')}</p>
        
        <div class="trust-indicators">
            <div class="trust-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="check"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span>{isHu ? '100% Átláthatóság' : '100% Transparent'}</span>
            </div>
            <div class="trust-item">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="check"><polyline points="20 6 9 17 4 12"></polyline></svg>
                <span>{isHu ? 'Helyi Hatás' : 'Direct Local Impact'}</span>
            </div>
        </div>
      </div>
      
      <!-- Premium UI Controls -->
      <div class="ui-pitch reveal">
          <div class="floating-controls">
              <div class="ctrl-group">
                  <label>{isHu ? 'Pénznem' : 'Currency'}</label>
                  <div class="pill-group">
                      <button>HUF</button>
                      <button>EUR</button>
                      <button class="active">RON</button>
                  </div>
              </div>
              <div class="ctrl-group">
                  <label>{isHu ? 'Típus' : 'Type'}</label>
                  <div class="pill-group">
                      <button>{t('support.method_card')}</button>
                      <button>{t('support.method_transfer')}</button>
                      <button class="active">{t('support.method_tax')}</button>
                  </div>
              </div>
          </div>
      </div>
    </div>
  </div>

  <!-- Form Section - Modern "Linear" style -->
  <div class="form-wrapper">
    <div class="container container-sm">
      
      <div class="notice-card">
        <p>
            {isHu ? 'Ha az űrlap nem jelenik meg megfelelően, felajánlásod ' : 'Dacă formularul nu este afișat corect, poți dona '} 
            <a href="https://redirectioneaza.ro" target="_blank">{isHu ? 'ezen a biztonságos linken' : 'prin acest link securizat'}</a> 
            {isHu ? 'is elvégezheted.' : ' de asemenea.'}
        </p>
      </div>

      <div class="saas-form-card reveal">
        <div class="form-header">
            <div class="org-info">
                <img src="/logo.png" alt="Logo" class="mini-logo" />
                <div>
                    <h3>Asociația O Șansă Pentru Comunitate</h3>
                    <p>{t('support.form_title')}</p>
                </div>
            </div>
        </div>

        <div class="step-guide">
            <div class="guide-box">
                {isHu ? 'Kitöltés online → Hitelesítés → Automatikus beküldés az ANAF-hoz.' : 'Completează online → Semnează → Depunere automată la ANAF.'}
            </div>
        </div>

        <form class="modern-form">
            <div class="form-section-title">01. {isRo ? 'Identificare' : 'Azonosítás'}</div>
            <div class="form-grid">
                <div class="input-group">
                    <label>Nume / Vezetéknév *</label>
                    <input type="text" placeholder="Ex: Popescu" />
                </div>
                <div class="input-group">
                    <label>Prenume / Utónév *</label>
                    <input type="text" placeholder="Ex: Ion" />
                </div>
                <div class="input-group full">
                    <label>CNP / Személyi szám *</label>
                    <input type="text" placeholder="1234567890..." />
                </div>
            </div>

            <div class="form-section-title">02. {isRo ? 'Adresa' : 'Lakcím'}</div>
            <div class="form-grid">
                <div class="input-group">
                    <label>Județ / Megye *</label>
                    <select>
                        <option value="">Selectează...</option>
                        <option>Harghita</option>
                        <option>Covasna</option>
                    </select>
                </div>
                <div class="input-group">
                    <label>Localitate / Város *</label>
                    <input type="text" placeholder="Ex: Cristuru Secuiesc" />
                </div>
            </div>

            <div class="signature-block">
                <div class="form-section-title">03. {isRo ? 'Semnătură' : 'Aláírás'}</div>
                <p class="instr">{isRo ? 'Semnează în interiorul chenarului' : 'Írd alá a kereten belül'}</p>
                <div class="canvas-area">
                    <div class="brush-icon">✏️</div>
                    <div class="sig-line"></div>
                </div>
            </div>

            <div class="consent-block">
                <label class="checkbox-container">
                    <input type="checkbox" />
                    <span class="checkmark"></span>
                    <span class="label-text">{isRo ? 'Sunt de acord cu prelucrarea datelor cu caracter personal (GDPR).' : 'Hozzájárulok a személyes adataim kezeléséhez (GDPR).'}</span>
                </label>
            </div>

            <div class="form-footer">
                <button type="submit" class="btn btn-primary btn-block">
                    {isRo ? 'TRIMITE FORMULARUL' : 'ŰRLAP BEKÜLDÉSE'}
                </button>
            </div>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  #support-premium {
    min-height: 100vh;
    padding-top: 5rem;
  }
  
  /* Pitch Section */
  .why-support {
    background: #0f172a;
    color: white;
    padding: 8rem 0;
    position: relative;
    overflow: hidden;
  }
  .pitch-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }
  .impact-badge {
    color: var(--primary-light);
    font-weight: 800;
    text-transform: uppercase;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    margin-bottom: 1rem;
    display: block;
  }
  .pitch-content h2 {
    font-size: 3.5rem;
    margin-bottom: 2rem;
    line-height: 1.1;
  }
  .pitch-content p {
    font-size: 1.25rem;
    color: #94a3b8;
    line-height: 1.7;
    margin-bottom: 3rem;
  }
  .trust-indicators {
    display: flex;
    gap: 2rem;
  }
  .trust-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-weight: 600;
    color: #f1f5f9;
  }
  .check { width: 20px; color: #10b981; }

  /* UI Pitch - Controls */
  .ui-pitch {
    position: relative;
  }
  .floating-controls {
    background: rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 2.5rem;
    border-radius: 32px;
    box-shadow: 0 40px 100px -20px rgba(0,0,0,0.5);
  }
  .ctrl-group {
    margin-bottom: 2rem;
  }
  .ctrl-group:last-child { margin: 0; }
  .ctrl-group label {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    color: #64748b;
    text-transform: uppercase;
    margin-bottom: 1rem;
  }
  .pill-group {
    display: flex;
    gap: 0.5rem;
    background: rgba(0,0,0,0.3);
    padding: 0.4rem;
    border-radius: 16px;
  }
  .pill-group button {
    flex: 1;
    background: transparent;
    border: none;
    color: #94a3b8;
    padding: 0.75rem;
    border-radius: 12px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s;
    font-size: 0.85rem;
  }
  .pill-group button.active {
    background: var(--primary);
    color: white;
    box-shadow: 0 4px 12px rgba(79, 70, 229, 0.4);
  }

  /* Form Section */
  .form-wrapper {
    padding: 6rem 0;
    background: var(--bg-soft);
  }
  .container-sm { max-width: 720px; }
  
  .notice-card {
    background: rgba(79, 70, 229, 0.05);
    border: 1px dashed var(--primary-light);
    padding: 1.25rem;
    border-radius: 16px;
    text-align: center;
    margin-bottom: 3rem;
    font-weight: 500;
  }
  .notice-card a { color: var(--primary); text-decoration: none; font-weight: 700; }

  .saas-form-card {
    background: white;
    border-radius: 32px;
    padding: 4rem;
    box-shadow: var(--shadow-premium);
    border: 1px solid #f1f5f9;
  }
  
  .form-header {
    margin-bottom: 3rem;
  }
  .org-info {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .mini-logo { height: 64px; }
  .org-info h3 { font-size: 1.5rem; margin-bottom: 0.25rem; }
  .org-info p { color: var(--text-muted); font-size: 0.95rem; }

  .guide-box {
    background: #f8fafc;
    padding: 1rem;
    border-radius: 12px;
    text-align: center;
    font-size: 0.9rem;
    color: var(--primary);
    font-weight: 600;
    margin-bottom: 3rem;
  }

  .form-section-title {
    font-size: 0.7rem;
    font-weight: 800;
    color: var(--primary);
    background: rgba(79, 70, 229, 0.1);
    padding: 0.4rem 0.75rem;
    border-radius: 6px;
    display: inline-block;
    margin-bottom: 1.5rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-bottom: 3rem;
  }
  .input-group.full { grid-column: span 2; }
  .input-group label {
    display: block;
    font-size: 0.85rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
    color: #475569;
  }
  .input-group input, .input-group select {
    width: 100%;
    padding: 1rem;
    background: #f8fafc;
    border: 2px solid transparent;
    border-radius: 14px;
    font-size: 1rem;
    color: var(--text-main);
    transition: all 0.2s;
  }
  .input-group input:focus {
    border-color: var(--primary-light);
    background: white;
    outline: none;
    box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.1);
  }

  .signature-block { margin-bottom: 3rem; }
  .instr { font-size: 0.85rem; color: var(--text-muted); margin-bottom: 1rem; }
  .canvas-area {
    height: 160px;
    background: #f8fafc;
    border: 2px dashed #cbd5e1;
    border-radius: 16px;
    position: relative;
    cursor: crosshair;
  }
  .sig-line {
    position: absolute;
    bottom: 40px;
    left: 10%;
    right: 10%;
    height: 1px;
    background: #94a3b8;
  }
  .brush-icon {
    position: absolute;
    bottom: 45px;
    left: 8%;
    font-size: 1.5rem;
    opacity: 0.3;
  }

  .btn-block { width: 100%; padding: 1.25rem; font-size: 1.1rem; }

  @media (max-width: 1024px) {
    .pitch-container { grid-template-columns: 1fr; text-align: center; }
    .pitch-content h2 { font-size: 2.5rem; }
    .trust-indicators { justify-content: center; }
    .saas-form-card { padding: 2rem; }
  }
  @media (max-width: 640px) {
    .form-grid { grid-template-columns: 1fr; }
    .input-group.full { grid-column: span 1; }
  }
</style>
