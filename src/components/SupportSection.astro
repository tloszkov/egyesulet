---
import { useTranslations } from '../i18n/utils';
const { lang } = Astro.props;
const t = useTranslations(lang as any);
---

<section id="support" style="background: var(--bg-soft); padding: 6rem 0;">
  <div class="container">
    <div class="section-title">
      <h2>{t('hero.cta_support')}</h2>
      <div style="width: 60px; height: 4px; background: var(--color-secondary); margin: 0 auto; border-radius: 2px;"></div>
    </div>
    
    <div class="grid-2" style="margin-top: 3rem;">
      <div class="card" style="padding: 3rem; text-align: center;">
        <h3 style="margin-bottom: 1.5rem;">{t('support.tax_title')}</h3>
        <p style="margin-bottom: 2rem;">{t('support.tax_text')}</p>
        <a href="#" class="btn btn-primary">{t('support.tax_cta')}</a>
      </div>
      
      <div class="card" style="padding: 3rem; text-align: center;">
        <h3 style="margin-bottom: 1.5rem;">{t('support.direct_title')}</h3>
        <p style="margin-bottom: 1rem;">{t('support.direct_text')}</p>
        <div style="background: #f8fafc; padding: 1.5rem; border-radius: 12px; font-family: monospace; text-align: left;">
          <p><strong>{t('support.bank_titular')}:</strong> Asociația O Șansă Pentru Comunitate</p>
          <p><strong>{t('support.bank_iban')}:</strong> RO00 XXXX XXXX XXXX XXXX XXXX</p>
          <p><strong>{t('support.bank_bank')}:</strong> BCR</p>
          <p><strong>{t('support.bank_swift')}:</strong> RNCB ROBU</p>
        </div>
      </div>
    </div>
  </div>
</section>
