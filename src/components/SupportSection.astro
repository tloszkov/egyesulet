---
import { useTranslations } from '../i18n/utils';
const { lang } = Astro.props;
const t = useTranslations(lang as any);

const isRo = lang === 'ro';
const isHu = lang === 'hu';
---

<section id="support" style="background: #f3f4f6; padding: 4rem 0;">
  <div class="container" style="max-width: 800px;">
    
    <!-- Page Header -->
    <div style="text-align: center; margin-bottom: 3rem;">
      <h1 style="display: inline-block; background: #262626; color: white; padding: 0.5rem 1.5rem; border-radius: 4px; font-size: 2rem; font-weight: 700;">
        {t('support.donation_title')}
      </h1>
    </div>

    <!-- Selectors -->
    <div style="display: flex; flex-direction: column; align-items: center; gap: 1.5rem; margin-bottom: 2.5rem;">
      <div style="display: flex; gap: 0.75rem;">
        <button class="sel-btn">HUF</button>
        <button class="sel-btn">EUR</button>
        <button class="sel-btn active">RON</button>
      </div>
      <div style="display: flex; gap: 0.75rem; flex-wrap: wrap; justify-content: center;">
        <button class="sel-btn">{t('support.method_card')}</button>
        <button class="sel-btn">{t('support.method_transfer')}</button>
        <button class="sel-btn active">{t('support.method_tax')}</button>
      </div>
    </div>

    <!-- Form Notice -->
    <div style="text-align: center; margin-bottom: 2rem; font-size: 0.95rem; color: #374151; line-height: 1.6;">
      <p>
        {isHu ? 'Ha az űrlap nem megfelelően jelenik meg, vagy nem működik jól, akkor az adófelajánlást ' : 'Dacă formularul nu se afișează corect sau nu funcționează bine, redirecționarea poate fi făcută și '}
        <a href="https://redirectioneaza.ro" style="color: #ef4444; text-decoration: none; font-weight: 600;">{isHu ? 'ezen a linken' : 'la acest link'}</a>
        {isHu ? ' is meg lehet tenni.' : '.'}
      </p>
    </div>

    <!-- The actual Form 230 Container -->
    <div style="background: white; border: 1px solid #e5e7eb; border-radius: 8px; padding: 2.5rem; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);">
        
        <!-- Form Header -->
        <div style="text-align: center; margin-bottom: 2.5rem;">
            <p style="font-size: 0.9rem; color: #4b5563; margin-bottom: 1.5rem;">Redirecționează 3,5% gratuit</p>
            <img src="/logo.png" alt="Logo" style="height: 100px; width: auto; margin-bottom: 1.5rem;" />
            <p style="font-size: 0.85rem; color: #4b5563; margin-bottom: 1rem;">Redirecționează 3,5% gratuit din impozitul tău către</p>
            <h2 style="color: #7c8bef; font-size: 1.75rem; font-weight: 600; margin-bottom: 1.5rem;">Asociația O Șansă Pentru Comunitate</h2>
            
            <p style="font-size: 0.95rem; color: #374151; max-width: 600px; margin: 0 auto;">
                {isHu ? 'Ezen a felületen tudod felajánlani a személyi jövedelemadód 3,5%-át az Egy Esély a Közösségért Egyesületnek.' : 'Pe această platformă puteți redirecționa 3,5% din impozitul pe venit către Asociația O Șansă Pentru Comunitate.'}
            </p>
        </div>

        <!-- Instructions Blue Box -->
        <div style="background: #eef2ff; border-radius: 4px; padding: 1.5rem; margin-bottom: 2rem; text-align: center;">
            <p style="font-size: 0.9rem; font-style: italic; color: #374151; line-height: 1.5;">
                {isHu ? 'Completează, semnează și trimite formularul 230 online.' : 'Completează, semnează și trimite formularul 230 online.'}<br/>
                {isHu ? 'Egyesületünk csapata gondoskodik az ANAF-hoz történő benyújtásról.' : 'Echipa organizației se va ocupa să depună formularul la ANAF.'}
            </p>
        </div>

        <!-- Form Sections -->
        <div style="display: flex; flex-direction: column; gap: 1rem;">
            
            <!-- Identification Section -->
            <div class="section-bar">Date de identificare a contribuabilului</div>
            <div class="field"><label>Nume *</label><input type="text" /></div>
            <div class="field"><label>Prenume *</label><input type="text" /></div>
            <div class="field"><label>Inițială Tată (opțional)</label><input type="text" /></div>
            <div class="field"><label>CNP / NIF *</label><input type="text" /></div>
            <div class="field"><label>Email</label><input type="email" /></div>
            <div class="field"><label>Telefon (opțional)</label><input type="text" /></div>

            <!-- Address Section -->
            <div class="section-bar" style="margin-top: 1rem;">Adresa de domiciliu (așa cum apare în documentul de identitate)</div>
            <div class="field"><label>Județ* (alege)</label><select><option></option></select></div>
            <div class="field"><label>Localitate* (alege)</label><select><option></option></select></div>
            <div class="field"><label>Cod poștal</label><input type="text" /></div>
            <div class="field"><label>Stradă *</label><input type="text" /></div>
            
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                <div class="field"><label>Nr *</label><input type="text" /></div>
                <div class="field"><label>Bloc</label><input type="text" /></div>
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1rem;">
                <div class="field"><label>Scara</label><input type="text" /></div>
                <div class="field"><label>Etaj</label><input type="text" /></div>
                <div class="field"><label>Apartament</label><input type="text" /></div>
            </div>

            <!-- Period Section -->
            <div class="section-bar" style="margin-top: 1rem;">Perioada redirecționării</div>
            <div style="padding: 1rem; display: flex; gap: 2rem;">
                <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
                    <input type="checkbox" checked /> Un an
                </label>
                <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer;">
                    <input type="checkbox" /> Doi ani
                </label>
            </div>

            <!-- Signature Section -->
            <div class="section-bar" style="margin-top: 1rem;">Semnătură olograf *</div>
            <p style="font-size: 0.8rem; color: #6b7280; font-style: italic; text-align: center; margin: 1rem 0;">
                {isHu ? '(Semnează olograf / de mână cât mai centrat pe linie pentru o încadrare bună. Folosește touchscreen-ul de pe telefon, tabletă, laptop etc.)' : '(Semnează olograf / de mână cât mai centrat pe linie pentru o încadrare bună. Folosește touchscreen-ul de pe telefon, tabletă, laptop etc.)'}
            </p>
            <div style="border: 1px dotted #9ca3af; border-radius: 4px; height: 180px; position: relative; background: #fff;">
                <div style="position: absolute; bottom: 40px; left: 10%; right: 10%; border-bottom: 2px solid #9ca3af;"></div>
                <div style="position: absolute; bottom: 45px; left: 10%; font-size: 1.5rem; color: #9ca3af; transform: rotate(-20deg);">✏️</div>
            </div>
            
            <label style="display: flex; align-items: flex-start; gap: 0.75rem; margin-top: 1rem; font-size: 0.85rem; color: #374151; cursor: pointer;">
                <input type="checkbox" style="margin-top: 0.2rem;" /> 
                {isHu ? 'Sunt de acord ca datele de identificare (nume, prenume și cod numeric personal/număr de identificare fiscală), precum és a suma direcționată să fie comunicate entității beneficiare.' : 'Sunt de acord ca datele de identificare (nume, prenume și cod numeric personal/număr de identificare fiscală), precum și suma direcționată să fie comunicate entității beneficiare.'}
            </label>

            <!-- Submit footer -->
            <div style="margin-top: 2rem; border-top: 1px solid #e5e7eb; padding-top: 2rem; text-align: center;">
                <button style="background: #7c8bef; color: white; border: none; padding: 0.75rem 3rem; border-radius: 4px; font-weight: 700; cursor: pointer; text-transform: uppercase; font-size: 1rem;">
                    {isHu ? 'KÜLDÉS' : 'TRIMITE'}
                </button>
            </div>
        </div>
    </div>

    <!-- Page Footer -->
    <div style="text-align: center; margin-top: 3rem; font-size: 0.85rem; color: #6b7280;">
      <p>{isHu ? 'Adatkezelési tájékoztatónk a 3,5%-os adófelajánlásról ' : 'Adatkezelési tájékoztatónk a 3,5%-os adófelajánlásról '} <a href="#" style="color: #ef4444; text-decoration: none;">{isHu ? 'itt' : 'itt'}</a> {isHu ? 'található.' : 'található.'}</p>
    </div>
  </div>
</section>

<style>
  .sel-btn {
    background: white;
    border: 1px solid #262626;
    color: #262626;
    padding: 0.5rem 1.25rem;
    border-radius: 4px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
    min-width: 70px;
    font-size: 0.9rem;
  }
  .sel-btn:hover {
    background: #f9fafb;
  }
  .sel-btn.active {
    background: #262626;
    color: white;
  }
  .section-bar {
    background: #7c8bef;
    color: white;
    padding: 0.5rem 1rem;
    font-weight: 600;
    font-size: 0.95rem;
    border-radius: 2px;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .field label {
    font-size: 0.85rem;
    color: #6b7280;
    padding-left: 0.25rem;
  }
  .field input, .field select {
    border: none;
    border-bottom: 1.5px solid #e5e7eb;
    padding: 0.5rem;
    font-size: 1rem;
    background: transparent;
    outline: none;
    transition: border-bottom 0.2s;
  }
  .field input:focus {
    border-bottom: 1.5px solid #7c8bef;
  }
</style>
