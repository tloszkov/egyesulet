---
import { useTranslations } from '../i18n/utils';
const { lang } = Astro.props;
const t = useTranslations(lang as any);

const links = {
    ro: {
        about: '/despre-noi',
        projects: '/proiecte',
        news: '/stiri',
        contact: '/contact',
        support: '/sustine-ne'
    },
    hu: {
        about: '/hu/rolunk',
        projects: '/hu/projektek',
        news: '/hu/hirek',
        contact: '/hu/kapcsolat',
        support: '/hu/tamogatas'
    },
    en: {
        about: '/en/about',
        projects: '/en/projects',
        news: '/en/news',
        contact: '/en/contact',
        support: '/en/support'
    }
}[lang as 'ro' | 'hu' | 'en'];
---

<header>
  <div class="container nav-wrapper">
    <nav>
      <div class="logo-container">
        <a href={lang === 'ro' ? '/' : `/${lang}/`}>
          <img src="/logo.png" alt="Logo" style="height: 48px; width: auto;" />
        </a>
      </div>
      <ul class="nav-links">
        <li><a href={lang === 'ro' ? '/' : `/${lang}/`}>{t('nav.home')}</a></li>
        <li><a href={links.about}>{t('nav.about')}</a></li>
        <li><a href={links.projects}>{t('nav.projects')}</a></li>
        <li><a href={links.news}>{t('nav.news')}</a></li>
        <li><a href={links.contact}>{t('nav.contact')}</a></li>
        <li><a href={links.support} class="btn-support-nav">{t('hero.cta_support')}</a></li>
      </ul>
      <div class="lang-switcher">
        <a href="/" class={`lang-btn ${lang === 'ro' ? 'active' : ''}`}>RO</a>
        <a href="/hu/" class={`lang-btn ${lang === 'hu' ? 'active' : ''}`}>HU</a>
        <a href="/en/" class={`lang-btn ${lang === 'en' ? 'active' : ''}`}>EN</a>
      </div>
      <button class="mobile-toggle" id="menu-toggle">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </nav>
  </div>
</header>

<style>
    .btn-support-nav {
        background: var(--color-secondary);
        color: white !important;
        padding: 0.5rem 1rem !important;
        border-radius: 8px;
        font-weight: 600;
        transition: transform 0.2s;
    }
    .btn-support-nav:hover {
        transform: translateY(-2px);
        background: #9d174d; /* Darker pink */
    }
</style>

<script>
  const menuToggle = document.getElementById('menu-toggle');
  const navLinks = document.querySelector('.nav-links');
  
  if (menuToggle && navLinks) {
    menuToggle.addEventListener('click', () => {
      navLinks.classList.toggle('active');
    });
  }

  document.querySelectorAll('.nav-links a').forEach(link => {
    link.addEventListener('click', () => {
      navLinks?.classList.remove('active');
    });
  });

  const header = document.querySelector('header');
  window.addEventListener('scroll', () => {
    if (header) {
      if (window.scrollY > 50) {
        header.style.padding = '0.5rem 0';
        header.style.boxShadow = 'var(--shadow-md)';
      } else {
        header.style.padding = '1rem 0';
        header.style.boxShadow = 'none';
      }
    }
  });
</script>
