---
import { useTranslations } from '../i18n/utils';
const { lang } = Astro.props;
const t = useTranslations(lang as any);

const links = {
    ro: { about: '/despre-noi', projects: '/proiecte', news: '/stiri', contact: '/contact', support: '/sustine-ne' },
    hu: { about: '/hu/rolunk', projects: '/hu/projektek', news: '/hu/hirek', contact: '/hu/kapcsolat', support: '/hu/tamogatas' },
    en: { about: '/en/about', projects: '/en/projects', news: '/en/news', contact: '/en/contact', support: '/en/support' }
}[lang as 'ro' | 'hu' | 'en'];
---

<header>
  <div class="container nav-wrapper">
    <nav>
      <div class="logo-container">
        <a href={lang === 'ro' ? '/' : `/${lang}/`} style="display: flex; align-items: center; gap: 1rem; text-decoration: none;">
          <img src="/logo.png" alt="Logo" style="height: 42px; width: auto;" />
          <span style="font-weight: 800; font-size: 1.25rem; color: var(--text-main); letter-spacing: -0.01em;">OSPC</span>
        </a>
      </div>
      
      <ul class="nav-links">
        <li><a href={lang === 'ro' ? '/' : `/${lang}/`}>{t('nav.home')}</a></li>
        <li><a href={links.about}>{t('nav.about')}</a></li>
        <li><a href={links.projects}>{t('nav.projects')}</a></li>
        <li><a href={links.news}>{t('nav.news')}</a></li>
        <li><a href={links.contact}>{t('nav.contact')}</a></li>
      </ul>

      <div style="display: flex; align-items: center; gap: 1.5rem;">
        <div class="lang-selector">
          <a href="/" class={lang === 'ro' ? 'active' : ''}>RO</a>
          <a href="/hu/" class={lang === 'hu' ? 'active' : ''}>HU</a>
          <a href="/en/" class={lang === 'en' ? 'active' : ''}>EN</a>
        </div>
        <a href={links.support} class="btn btn-primary" style="padding: 0.6rem 1.25rem; font-size: 0.9rem; border-radius: 10px;">
          {t('hero.cta_support')}
        </a>
      </div>

      <button class="mobile-toggle" id="menu-toggle">
        <span></span><span></span><span></span>
      </button>
    </nav>
  </div>
</header>

<style>
  .lang-selector {
    display: flex;
    gap: 0.5rem;
    background: #f1f5f9;
    padding: 0.25rem;
    border-radius: 8px;
  }
  .lang-selector a {
    text-decoration: none;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-muted);
    padding: 0.4rem 0.6rem;
    border-radius: 6px;
    transition: all 0.2s;
  }
  .lang-selector a.active {
    background: white;
    color: var(--primary);
    box-shadow: var(--shadow-sm);
  }
  .mobile-toggle {
    display: none;
    flex-direction: column;
    gap: 4px;
    background: none;
    border: none;
    cursor: pointer;
  }
  .mobile-toggle span {
    width: 24px;
    height: 2px;
    background: var(--text-main);
    border-radius: 2px;
  }
  @media (max-width: 768px) {
    .mobile-toggle { display: flex; }
    .nav-links, .lang-selector, .btn-primary { display: none; }
  }
</style>
