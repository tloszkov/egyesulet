---
import { useTranslations } from '../i18n/utils';
import PartnersSection from './PartnersSection.astro';
const { lang } = Astro.props;
const t = useTranslations(lang as any);
---

<main>
  <!-- Hero Section - High End -->
  <section class="hero-premium reveal">
    <div class="container hero-grid">
      <div class="hero-content">
        <div class="badge">{lang === 'hu' ? 'Közösségi Összefogás' : 'Impact for Community'}</div>
        <h1>
          {t('hero.title1')}
          <span class="gradient-text">{t('hero.title2')}</span>
        </h1>
        <p class="hero-p">{t('hero.description')}</p>
        <div class="hero-actions">
          <a href={lang === 'ro' ? '/sustine-ne' : lang === 'hu' ? '/hu/tamogatas' : '/en/support'} class="btn btn-primary btn-lg">
            {t('hero.cta_support')}
          </a>
          <a href={lang === 'ro' ? '/despre-noi' : lang === 'hu' ? '/hu/rolunk' : '/en/about'} class="btn btn-secondary btn-lg">
            {t('nav.about')}
          </a>
        </div>
      </div>
      <div class="hero-visual">
         <div class="abstract-shape shape-1"></div>
         <div class="abstract-shape shape-2"></div>
         <img src="/logo.png" alt="OSPC" class="hero-logo-float" />
      </div>
    </div>
  </section>

  <!-- Impact/Stats Section -->
  <section style="padding: 4rem 0;" class="reveal">
    <div class="container">
        <div class="stats-grid">
            <div class="stat-item">
                <div class="stat-val">3+</div>
                <div class="stat-label">{lang === 'hu' ? 'Aktív Év' : 'Active Years'}</div>
            </div>
            <div class="stat-item">
                <div class="stat-val">10+</div>
                <div class="stat-label">{lang === 'hu' ? 'Sikeres Projekt' : 'Projects Completed'}</div>
            </div>
            <div class="stat-item">
                <div class="stat-val">100%</div>
                <div class="stat-label">{lang === 'hu' ? 'Átláthatóság' : 'Transparency'}</div>
            </div>
        </div>
    </div>
  </section>

  <PartnersSection lang={lang} />

  <!-- 3.5% Tax Callout -->
  <section class="tax-callout-section reveal">
    <div class="container">
      <div class="tax-callout-card">
        <div class="tax-callout-left">
          <div class="tax-percent-badge">3,5%</div>
          <div class="tax-callout-text">
            <h2>
              {lang === 'hu' ? 'Ajánld fel adód 3,5%-át — ingyen!' :
               lang === 'ro' ? 'Redirecționează 3,5% din impozit — gratuit!' :
               'Redirect 3.5% of your tax — for free!'}
            </h2>
            <p>
              {lang === 'hu' ? 'Az összeg az általad már megfizetett adóból érkezik. Neked semmibe sem kerül, nekünk sokat jelent.' :
               lang === 'ro' ? 'Suma vine din impozitul pe care îl plătești oricum. Nu te costă nimic în plus, dar pentru noi înseamnă enorm.' :
               'The amount comes from taxes you already pay. It costs you nothing extra, but means everything to us.'}
            </p>
            <div class="tax-callout-checks">
              <span>
                <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                {lang === 'hu' ? 'Nem kerül többe' : lang === 'ro' ? 'Nu costă mai mult' : 'No extra cost'}
              </span>
              <span>
                <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                {lang === 'hu' ? '5 perces folyamat' : lang === 'ro' ? 'Durează 5 minute' : '5 minute process'}
              </span>
              <span>
                <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                {lang === 'hu' ? 'Helyi hatás' : lang === 'ro' ? 'Impact local' : 'Local impact'}
              </span>
            </div>
          </div>
        </div>
        <div class="tax-callout-right">
          <div class="tax-deadline-chip">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            {lang === 'hu' ? 'Határidő: 2026. május 25.' : lang === 'ro' ? 'Termen: 25 mai 2026' : 'Deadline: May 25, 2026'}
          </div>
          <a href={lang === 'ro' ? '/sustine-ne' : lang === 'hu' ? '/hu/tamogatas' : '/en/support'} class="btn-tax-cta">
            {lang === 'hu' ? 'Felajánlom most' : lang === 'ro' ? 'Redirecționez acum' : 'Redirect now'}
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>
</main>

<style>
  .hero-premium {
    padding: 12rem 0 8rem;
    position: relative;
    overflow: hidden;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 4rem;
    align-items: center;
  }
  .badge {
    display: inline-block;
    padding: 0.5rem 1rem;
    background: rgba(79, 70, 229, 0.1);
    color: var(--primary);
    border-radius: 100px;
    font-weight: 700;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1.5rem;
  }
  h1 {
    font-size: 4.5rem;
    margin-bottom: 1.5rem;
    color: #1e293b;
  }
  .gradient-text {
    background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: block;
  }
  .hero-p {
    font-size: 1.25rem;
    color: var(--text-muted);
    max-width: 540px;
    margin-bottom: 2.5rem;
  }
  .hero-actions {
    display: flex;
    gap: 1.5rem;
  }
  .btn-lg {
    padding: 1.25rem 2.5rem;
    font-size: 1.1rem;
  }

  .hero-visual {
    position: relative;
    height: 500px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: visible;
  }
  .hero-logo-float {
    width: 320px !important;
    max-width: 90vw !important;
    height: auto !important;
    z-index: 10;
    filter: drop-shadow(0 20px 40px rgba(0,0,0,0.15));
    animation: float 6s ease-in-out infinite;
    display: block;
    margin: 0 auto;
  }
  .abstract-shape {
    position: absolute;
    filter: blur(80px);
    z-index: 1;
    border-radius: 50%;
  }
  .shape-1 {
    width: 400px;
    height: 400px;
    background: rgba(79, 70, 229, 0.2);
    top: 10%;
    right: -10%;
  }
  .shape-2 {
    width: 300px;
    height: 300px;
    background: rgba(236, 72, 153, 0.2);
    bottom: 10%;
    left: -10%;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    background: white;
    padding: 3rem;
    border-radius: 32px;
    box-shadow: var(--shadow-lg);
    border: 1px solid #f1f5f9;
  }
  .stat-item {
    text-align: center;
    border-right: 1px solid #f1f5f9;
  }
  .stat-item:last-child { border: none; }
  .stat-val {
    font-size: 3rem;
    font-weight: 800;
    color: var(--primary);
    margin-bottom: 0.25rem;
  }
  .stat-label {
    color: var(--text-muted);
    font-weight: 600;
    text-transform: uppercase;
    font-size: 0.8rem;
    letter-spacing: 0.05em;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-30px); }
  }

  @media (max-width: 1024px) {
    .hero-premium { padding: 8rem 0 4rem; }
    h1 { font-size: 3.5rem; }
    .hero-grid { grid-template-columns: 1fr; text-align: center; }
    .hero-p { margin: 0 auto 2.5rem; }
    .hero-actions { justify-content: center; }
    .hero-visual { display: none; }
  }

  @media (max-width: 768px) {
    h1 { font-size: 2.75rem; }
    .hero-actions { flex-direction: column; gap: 1rem; }
    .btn-lg { width: 100%; text-align: center; }
    .stats-grid { 
      padding: 2rem 1rem; 
      grid-template-columns: 1fr; 
      gap: 2rem;
    }
    .stat-item { 
      border-right: none; 
      border-bottom: 1px solid #f1f5f9; 
      padding-bottom: 2rem;
    }
    .stat-item:last-child { border: none; padding-bottom: 0; }
    .stat-val { font-size: 2.5rem; }
  }

  @media (max-width: 480px) {
    h1 { font-size: 2.25rem; }
    .hero-premium { padding: 6rem 0 3rem; }
  }

  /* 3.5% Tax Callout */
  .tax-callout-section {
    padding: 4rem 0 6rem;
  }

  .tax-callout-card {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 3rem;
    align-items: center;
    background: #0f172a;
    border-radius: 32px;
    padding: 3.5rem 4rem;
    position: relative;
    overflow: hidden;
  }

  .tax-callout-card::before {
    content: '';
    position: absolute;
    top: -60px;
    right: 200px;
    width: 350px;
    height: 350px;
    background: radial-gradient(circle, rgba(79,70,229,0.25) 0%, transparent 70%);
    pointer-events: none;
  }

  .tax-callout-left {
    display: flex;
    align-items: flex-start;
    gap: 2.5rem;
    position: relative;
    z-index: 1;
  }

  .tax-percent-badge {
    font-size: 5rem;
    font-weight: 900;
    line-height: 1;
    background: linear-gradient(135deg, #818cf8 0%, #ec4899 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    flex-shrink: 0;
    letter-spacing: -0.03em;
  }

  .tax-callout-text h2 {
    font-size: 1.75rem;
    color: white;
    margin-bottom: 0.75rem;
    line-height: 1.2;
    font-weight: 800;
  }

  .tax-callout-text p {
    color: #94a3b8;
    font-size: 1rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
    max-width: 480px;
  }

  .tax-callout-checks {
    display: flex;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .tax-callout-checks span {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: #e2e8f0;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .tax-callout-checks svg {
    width: 16px;
    height: 16px;
    color: #10b981;
    flex-shrink: 0;
  }

  .tax-callout-right {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
    position: relative;
    z-index: 1;
  }

  .tax-deadline-chip {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(251, 191, 36, 0.15);
    border: 1px solid rgba(251, 191, 36, 0.4);
    color: #fbbf24;
    padding: 0.5rem 1rem;
    border-radius: 100px;
    font-size: 0.8rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .btn-tax-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 1rem 2rem;
    background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
    color: white;
    border-radius: 14px;
    font-weight: 800;
    font-size: 1rem;
    text-decoration: none;
    transition: all 0.25s;
    box-shadow: 0 8px 24px rgba(79, 70, 229, 0.4);
    white-space: nowrap;
  }

  .btn-tax-cta:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 40px rgba(79, 70, 229, 0.5);
  }

  @media (max-width: 1024px) {
    .tax-callout-card {
      grid-template-columns: 1fr;
      padding: 2.5rem;
      gap: 2rem;
    }
    .tax-callout-right { align-items: flex-start; }
  }

  @media (max-width: 640px) {
    .tax-callout-left { flex-direction: column; gap: 1.5rem; }
    .tax-percent-badge { font-size: 4rem; }
    .tax-callout-text h2 { font-size: 1.4rem; }
    .tax-callout-checks { gap: 1rem; }
    .btn-tax-cta { width: 100%; justify-content: center; }
  }
</style>
