---
import { useTranslations } from '../i18n/utils';
import AboutSection from './AboutSection.astro';
import ProjectsSection from './ProjectsSection.astro';

const { lang } = Astro.props;
const t = useTranslations(lang as any);
---

<main>
  <!-- Hero Section -->
  <section id="home" class="hero">
    <div class="container">
      <h1>{t('hero.title1')}<br><span style="color: var(--color-primary)">{t('hero.title2')}</span></h1>
      <p>{t('hero.description')}</p>
      <div class="cta-group">
        <a href={lang === 'ro' ? '/sustine-ne' : `/${lang}/tamogatas`} class="btn btn-primary">{t('hero.cta_support')}</a>
        <a href={lang === 'ro' ? '/despre-noi' : `/${lang}/rolunk`} class="btn btn-secondary">{t('nav.about')}</a>
      </div>
    </div>
  </section>

  <!-- Brief About Preview -->
  <AboutSection lang={lang} />
  
  <!-- Brief Projects Preview -->
  <ProjectsSection lang={lang} />
</main>
