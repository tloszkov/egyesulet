---
import { useTranslations } from '../i18n/utils';
const { lang } = Astro.props;
const t = useTranslations(lang as any);
---

<main>
  <!-- Hero Section - High End -->
  <section class="hero-premium reveal">
    <div class="container hero-grid">
      <div class="hero-content">
        <div class="badge">{lang === 'hu' ? 'Közösségi Összefogás' : 'Impact for Community'}</div>
        <h1>
          {t('hero.title1')}
          <span class="gradient-text">{t('hero.title2')}</span>
        </h1>
        <p class="hero-p">{t('hero.description')}</p>
        <div class="hero-actions">
          <a href={lang === 'ro' ? '/sustine-ne' : lang === 'hu' ? '/hu/tamogatas' : '/en/support'} class="btn btn-primary btn-lg">
            {t('hero.cta_support')}
          </a>
          <a href={lang === 'ro' ? '/despre-noi' : lang === 'hu' ? '/hu/rolunk' : '/en/about'} class="btn btn-secondary btn-lg">
            {t('nav.about')}
          </a>
        </div>
      </div>
      <div class="hero-visual">
         <div class="abstract-shape shape-1"></div>
         <div class="abstract-shape shape-2"></div>
         <img src="/logo.png" alt="OSPC" class="hero-logo-float" />
      </div>
    </div>
  </section>

  <!-- Impact/Stats Section -->
  <section style="padding: 4rem 0;" class="reveal">
    <div class="container">
        <div class="stats-grid">
            <div class="stat-item">
                <div class="stat-val">3+</div>
                <div class="stat-label">{lang === 'hu' ? 'Aktív Év' : 'Active Years'}</div>
            </div>
            <div class="stat-item">
                <div class="stat-val">10+</div>
                <div class="stat-label">{lang === 'hu' ? 'Sikeres Projekt' : 'Projects Completed'}</div>
            </div>
            <div class="stat-item">
                <div class="stat-val">100%</div>
                <div class="stat-label">{lang === 'hu' ? 'Átláthatóság' : 'Transparency'}</div>
            </div>
        </div>
    </div>
  </section>
</main>

<style>
  .hero-premium {
    padding: 12rem 0 8rem;
    position: relative;
    overflow: hidden;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 4rem;
    align-items: center;
  }
  .badge {
    display: inline-block;
    padding: 0.5rem 1rem;
    background: rgba(79, 70, 229, 0.1);
    color: var(--primary);
    border-radius: 100px;
    font-weight: 700;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1.5rem;
  }
  h1 {
    font-size: 4.5rem;
    margin-bottom: 1.5rem;
    color: #1e293b;
  }
  .gradient-text {
    background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: block;
  }
  .hero-p {
    font-size: 1.25rem;
    color: var(--text-muted);
    max-width: 540px;
    margin-bottom: 2.5rem;
  }
  .hero-actions {
    display: flex;
    gap: 1.5rem;
  }
  .btn-lg {
    padding: 1.25rem 2.5rem;
    font-size: 1.1rem;
  }

  .hero-visual {
    position: relative;
    height: 500px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: visible;
  }
  .hero-logo-float {
    width: 320px !important;
    max-width: 90vw !important;
    height: auto !important;
    z-index: 10;
    filter: drop-shadow(0 20px 40px rgba(0,0,0,0.15));
    animation: float 6s ease-in-out infinite;
    display: block;
    margin: 0 auto;
  }
  .abstract-shape {
    position: absolute;
    filter: blur(80px);
    z-index: 1;
    border-radius: 50%;
  }
  .shape-1 {
    width: 400px;
    height: 400px;
    background: rgba(79, 70, 229, 0.2);
    top: 10%;
    right: -10%;
  }
  .shape-2 {
    width: 300px;
    height: 300px;
    background: rgba(236, 72, 153, 0.2);
    bottom: 10%;
    left: -10%;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    background: white;
    padding: 3rem;
    border-radius: 32px;
    box-shadow: var(--shadow-lg);
    border: 1px solid #f1f5f9;
  }
  .stat-item {
    text-align: center;
    border-right: 1px solid #f1f5f9;
  }
  .stat-item:last-child { border: none; }
  .stat-val {
    font-size: 3rem;
    font-weight: 800;
    color: var(--primary);
    margin-bottom: 0.25rem;
  }
  .stat-label {
    color: var(--text-muted);
    font-weight: 600;
    text-transform: uppercase;
    font-size: 0.8rem;
    letter-spacing: 0.05em;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-30px); }
  }

  @media (max-width: 1024px) {
    .hero-premium { padding: 8rem 0 4rem; }
    h1 { font-size: 3.5rem; }
    .hero-grid { grid-template-columns: 1fr; text-align: center; }
    .hero-p { margin: 0 auto 2.5rem; }
    .hero-actions { justify-content: center; }
    .hero-visual { display: none; }
  }

  @media (max-width: 768px) {
    h1 { font-size: 2.75rem; }
    .hero-actions { flex-direction: column; gap: 1rem; }
    .btn-lg { width: 100%; text-align: center; }
    .stats-grid { 
      padding: 2rem 1rem; 
      grid-template-columns: 1fr; 
      gap: 2rem;
    }
    .stat-item { 
      border-right: none; 
      border-bottom: 1px solid #f1f5f9; 
      padding-bottom: 2rem;
    }
    .stat-item:last-child { border: none; padding-bottom: 0; }
    .stat-val { font-size: 2.5rem; }
  }

  @media (max-width: 480px) {
    h1 { font-size: 2.25rem; }
    .hero-premium { padding: 6rem 0 3rem; }
  }
</style>
