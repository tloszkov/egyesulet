---
import { useTranslations } from '../i18n/utils';
const { lang } = Astro.props;
const t = useTranslations(lang as any);

const isHu = lang === 'hu';
const isEn = lang === 'en';
---

<section id="contact">
  <!-- Hero -->
  <div class="contact-hero">
    <div class="container">
      <span class="hero-badge">{isHu ? 'Lépj kapcsolatba velünk' : isEn ? 'Get in touch' : 'Contactează-ne'}</span>
      <h1>{t('nav.contact')}</h1>
      <p>{isHu ? 'Várjuk kérdéseidet, ötleteidet és észrevételeidet. Igyekszünk 1–2 munkanapon belül válaszolni.' : isEn ? 'We welcome your questions, ideas and feedback. We aim to respond within 1–2 business days.' : 'Suntem bucuroși să răspundem întrebărilor, ideilor și sugestiilor tale. Răspundem în 1–2 zile lucrătoare.'}</p>
    </div>
  </div>

  <div class="container contact-layout">

    <!-- Left: Info -->
    <div class="info-col">

      <div class="info-card reveal">
        <h2>{isHu ? 'Elérhetőségek' : isEn ? 'Contact Details' : 'Date de Contact'}</h2>

        <div class="info-item">
          <div class="info-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
          </div>
          <div>
            <span class="info-label">{isHu ? 'Cím' : isEn ? 'Address' : 'Adresă'}</span>
            <p>{t('contact.address')}</p>
          </div>
        </div>

        <div class="info-item">
          <div class="info-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
          </div>
          <div>
            <span class="info-label">{isHu ? 'Általános email' : isEn ? 'General email' : 'Email general'}</span>
            <a href={`mailto:${t('contact.email')}`}>{t('contact.email')}</a>
          </div>
        </div>

        <div class="info-item">
          <div class="info-icon info-icon--pink">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
          </div>
          <div>
            <span class="info-label">{t('contact.president')}</span>
            <p class="person-name">Kovács Zsolt</p>
            <a href={`mailto:${t('contact.president_email')}`}>{t('contact.president_email')}</a>
          </div>
        </div>
      </div>

      <div class="social-card reveal">
        <h3>{isHu ? 'Kövess minket' : isEn ? 'Follow us' : 'Urmărește-ne'}</h3>
        <div class="social-links">
          <a href="https://www.facebook.com/ospcom" target="_blank" rel="noopener noreferrer" class="social-btn social-btn--fb">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
            Facebook
          </a>
          <a href="https://www.instagram.com/ospc.egyesulet/" target="_blank" rel="noopener noreferrer" class="social-btn social-btn--ig">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
            Instagram
          </a>
        </div>
      </div>

    </div>

    <!-- Right: Form -->
    <div class="form-col reveal">
      <div class="form-card">
        <h2>{t('contact.form_title')}</h2>
        <p class="form-subtitle">{isHu ? 'Minden mező kitöltése kötelező.' : isEn ? 'All fields are required.' : 'Toate câmpurile sunt obligatorii.'}</p>

        <div id="form-status" style="display:none;"></div>

        <form id="contact-form" action="https://formspree.io/f/mzdagnde" method="POST">
          <div class="field">
            <label for="contact-name">{t('contact.name')}</label>
            <input type="text" id="contact-name" name="name" placeholder={isHu ? 'Kovács János' : isEn ? 'John Smith' : 'Ion Popescu'} required />
          </div>
          <div class="field">
            <label for="contact-email">{t('contact.email_label')}</label>
            <input type="email" id="contact-email" name="email" placeholder="email@example.com" required />
          </div>
          <div class="field">
            <label for="contact-message">{t('contact.message')}</label>
            <textarea id="contact-message" name="message" rows="5" placeholder={isHu ? 'Írj nekünk...' : isEn ? 'Write to us...' : 'Scrie-ne...'} required></textarea>
          </div>
          <button type="submit" class="btn-submit">
            <span class="btn-text">{t('contact.send')}</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
          </button>
        </form>
      </div>
    </div>

  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const status = document.getElementById('form-status');
  const btn = form?.querySelector('.btn-submit') as HTMLButtonElement;
  const btnText = btn?.querySelector('.btn-text');
  const lang = document.documentElement.lang;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!status || !btn || !btnText) return;

    btn.disabled = true;
    btnText.textContent = '...';

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { 'Accept': 'application/json' }
      });

      if (response.ok) {
        status.className = 'status-success';
        status.textContent = lang === 'hu'
          ? 'Köszönjük! Üzenetedet sikeresen elküldtük, hamarosan válaszolunk.'
          : lang === 'en'
          ? 'Thank you! Your message was sent successfully. We\'ll get back to you soon.'
          : 'Mulțumim! Mesajul tău a fost trimis cu succes. Îți vom răspunde în curând.';
        status.style.display = 'block';
        form.style.display = 'none';
      } else {
        throw new Error();
      }
    } catch {
      status.className = 'status-error';
      status.textContent = lang === 'hu'
        ? 'Hiba történt. Kérjük, írj nekünk közvetlenül emailben.'
        : lang === 'en'
        ? 'An error occurred. Please email us directly.'
        : 'A apărut o eroare. Te rugăm să ne scrii direct pe email.';
      status.style.display = 'block';
      btn.disabled = false;
      btnText.textContent = lang === 'hu' ? 'Küldés' : lang === 'en' ? 'Send Message' : 'Trimite';
    }
  });
</script>

<style>
  #contact {
    padding-bottom: 6rem;
  }

  /* Hero */
  .contact-hero {
    background: linear-gradient(135deg, #4f46e5 0%, #ec4899 100%);
    color: white;
    padding: 8rem 0 5rem;
    text-align: center;
    margin-bottom: 4rem;
  }
  .hero-badge {
    display: inline-block;
    background: rgba(255,255,255,0.2);
    padding: 0.4rem 1.25rem;
    border-radius: 100px;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    margin-bottom: 1.25rem;
  }
  .contact-hero h1 {
    font-size: 3.5rem;
    font-weight: 800;
    margin-bottom: 1rem;
  }
  .contact-hero p {
    font-size: 1.15rem;
    opacity: 0.9;
    max-width: 560px;
    margin: 0 auto;
    line-height: 1.7;
  }

  /* Layout */
  .contact-layout {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 2.5rem;
    align-items: start;
  }

  /* Info col */
  .info-card {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 24px;
    padding: 2.5rem;
    margin-bottom: 1.5rem;
    box-shadow: 0 4px 20px rgba(0,0,0,0.05);
  }
  .info-card h2 {
    font-size: 1.4rem;
    font-weight: 800;
    color: #1e293b;
    margin-bottom: 2rem;
  }
  .info-item {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    padding: 1.25rem 0;
    border-bottom: 1px solid #f1f5f9;
  }
  .info-item:last-child { border-bottom: none; padding-bottom: 0; }
  .info-item:first-of-type { padding-top: 0; }

  .info-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: rgba(79,70,229,0.08);
    color: #4f46e5;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .info-icon--pink {
    background: rgba(236,72,153,0.08);
    color: #ec4899;
  }

  .info-label {
    display: block;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: #94a3b8;
    margin-bottom: 0.3rem;
  }
  .info-item p, .info-item a {
    font-size: 0.95rem;
    font-weight: 600;
    color: #1e293b;
    text-decoration: none;
    line-height: 1.5;
    margin: 0;
  }
  .info-item a:hover { color: #4f46e5; }
  .person-name { margin-bottom: 0.2rem !important; }

  .social-card {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 24px;
    padding: 2rem 2.5rem;
    box-shadow: 0 4px 20px rgba(0,0,0,0.05);
  }
  .social-card h3 {
    font-size: 1rem;
    font-weight: 700;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    margin-bottom: 1.25rem;
  }
  .social-links { display: flex; flex-direction: column; gap: 0.75rem; }
  .social-btn {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem 1.25rem;
    border-radius: 14px;
    font-weight: 700;
    font-size: 0.95rem;
    text-decoration: none;
    transition: all 0.2s;
  }
  .social-btn--fb {
    background: #f0f4ff;
    color: #1877f2;
  }
  .social-btn--fb:hover { background: #1877f2; color: white; transform: translateY(-2px); }
  .social-btn--ig {
    background: #fdf2f8;
    color: #e1306c;
  }
  .social-btn--ig:hover { background: linear-gradient(135deg, #f09433, #e6683c, #dc2743, #cc2366, #bc1888); color: white; transform: translateY(-2px); }

  /* Form col */
  .form-card {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 24px;
    padding: 3rem;
    box-shadow: 0 4px 20px rgba(0,0,0,0.05);
  }
  .form-card h2 {
    font-size: 1.6rem;
    font-weight: 800;
    color: #1e293b;
    margin-bottom: 0.5rem;
  }
  .form-subtitle {
    color: #94a3b8;
    font-size: 0.9rem;
    margin-bottom: 2rem;
  }

  .field {
    margin-bottom: 1.5rem;
  }
  .field label {
    display: block;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #475569;
    margin-bottom: 0.6rem;
  }
  .field input, .field textarea {
    width: 100%;
    padding: 0.875rem 1rem;
    border: 1.5px solid #e2e8f0;
    border-radius: 12px;
    font-size: 1rem;
    font-family: inherit;
    color: #0f172a;
    background: #f8fafc;
    transition: all 0.2s;
    outline: none;
  }
  .field input:focus, .field textarea:focus {
    border-color: #4f46e5;
    background: white;
    box-shadow: 0 0 0 4px rgba(79,70,229,0.1);
  }
  .field textarea { resize: vertical; min-height: 120px; }

  .btn-submit {
    width: 100%;
    padding: 1rem 2rem;
    background: #4f46e5;
    color: white;
    border: none;
    border-radius: 14px;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    transition: all 0.2s;
    box-shadow: 0 6px 20px rgba(79,70,229,0.3);
  }
  .btn-submit:hover { background: #3730a3; transform: translateY(-2px); box-shadow: 0 10px 28px rgba(79,70,229,0.4); }
  .btn-submit:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }

  .status-success, .status-error {
    padding: 1.25rem;
    border-radius: 14px;
    font-weight: 600;
    margin-bottom: 1.5rem;
    line-height: 1.5;
  }
  .status-success { background: #dcfce7; color: #166534; }
  .status-error   { background: #fee2e2; color: #991b1b; }

  @media (max-width: 900px) {
    .contact-layout { grid-template-columns: 1fr; }
    .contact-hero h1 { font-size: 2.5rem; }
    .form-card { padding: 2rem; }
  }
  @media (max-width: 480px) {
    .contact-hero { padding: 6rem 0 3rem; }
    .contact-hero h1 { font-size: 2rem; }
    .info-card, .social-card { padding: 1.75rem; }
  }
</style>
