---
import { useTranslations } from '../i18n/utils';
const { lang } = Astro.props;
const t = useTranslations(lang as any);
---

<section id="about" class="reveal">
  <div class="container">
    <div class="section-title">
      <h2>{t('about.title')}</h2>
    </div>
    
    <div class="about-grid">
      <div class="about-info">
        <div class="about-card-intro">
          <p>{t('about.description')}</p>
        </div>
        
        <div class="about-card history-card">
          <h3>{t('about.history_title')}</h3>
          <p>{t('about.history_text')}</p>
        </div>

        <div class="about-card mission-highlight">
          <h3>{t('about.mission_title')}</h3>
          <p>{t('about.mission_text')}</p>
        </div>
      </div>
      <div class="about-visual">
      </div>
    </div>

    <!-- Pillars / Activity Areas -->
    <div class="pillars-container">
      <h3 class="pillars-title">{t('about.pillars_title')}</h3>
      <div class="grid-3">
        <div class="pillar-item">
          <div class="pillar-icon blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
          </div>
          <h4>{t('about.pillar_1')}</h4>
        </div>
        <div class="pillar-item">
          <div class="pillar-icon red">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"></line><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
          </div>
          <h4>{t('about.pillar_2')}</h4>
        </div>
        <div class="pillar-item">
          <div class="pillar-icon green">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"></path><path d="M5 3v4"></path><path d="M19 17v4"></path><path d="M3 5h4"></path><path d="M17 19h4"></path></svg>
          </div>
          <h4>{t('about.pillar_3')}</h4>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #about { padding: 6rem 0; }
  .about-grid {
    display: grid; 
    grid-template-columns: 1.2fr 0.8fr; 
    gap: 4rem; 
    align-items: start; 
    margin-bottom: 4rem;
  }
  .about-info { display: flex; flex-direction: column; gap: 2rem; }
  .about-card-intro p {
    font-size: 1.15rem; 
    color: var(--text-main); 
    font-weight: 500; 
    line-height: 1.7; 
    margin: 0;
    padding: 0 1rem;
    border-left: 4px solid #e2e8f0;
  }
  .about-card {
    background: white;
    padding: 2.5rem;
    border-radius: 24px;
    box-shadow: var(--shadow-sm);
    border: 1px solid #f1f5f9;
    transition: transform 0.3s ease;
  }
  .history-card { border-left: 4px solid var(--color-primary); }
  .history-card h3 { color: var(--color-primary); margin-bottom: 1rem; }
  .history-card p { line-height: 1.7; color: #475569; }
  
  .mission-highlight {
    border-left: 4px solid var(--color-secondary);
    background: linear-gradient(to bottom right, #ffffff, #fdfaff);
  }
  .mission-highlight h3 { margin-bottom: 1rem; color: #1e293b; }
  .mission-highlight p { line-height: 1.7; color: #475569; }

  .about-visual {
    background: url('/logo.png') center/contain no-repeat; 
    height: 400px; 
    border-radius: 20px; 
    opacity: 0.1;
  }

  /* Pillars */
  .pillars-container {
    background: white; 
    padding: 3rem; 
    border-radius: 24px; 
    box-shadow: var(--shadow-sm);
  }
  .pillars-title { text-align: center; margin-bottom: 3rem; font-size: 1.75rem; }
  .pillar-item { text-align: center; padding: 1rem; }
  .pillar-icon {
    width: 48px; height: 48px; 
    border-radius: 12px; 
    display: flex; align-items: center; justify-content: center; 
    margin: 0 auto 1.5rem;
  }
  .pillar-icon.blue { background: #eff6ff; color: var(--color-primary); }
  .pillar-icon.red { background: #fef2f2; color: #ef4444; }
  .pillar-icon.green { background: #f0fdf4; color: #22c55e; }

  @media (max-width: 1024px) {
    .about-grid { grid-template-columns: 1fr; gap: 2rem; }
    .about-visual { display: none; }
  }

  @media (max-width: 768px) {
    #about { padding: 4rem 0; }
    .about-card { padding: 1.5rem; }
    .pillars-container { padding: 2rem 1rem; }
    .grid-3 { grid-template-columns: 1fr; gap: 2rem; }
    .pillars-title { font-size: 1.5rem; margin-bottom: 2rem; }
  }
</style>

