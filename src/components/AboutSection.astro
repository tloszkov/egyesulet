---
import { useTranslations } from '../i18n/utils';
const { lang } = Astro.props;
const t = useTranslations(lang as any);
---

<section id="about" class="reveal">
  <!-- Hero Section -->
  <div class="about-hero">
    <div class="container">
      <div class="hero-content">
        <span class="hero-badge">{lang === 'ro' ? 'Despre Noi' : lang === 'hu' ? 'Rólunk' : 'About Us'}</span>
        <h1>{t('about.title')}</h1>
        <h2 class="hero-subtitle">{t('about.subtitle')}</h2>
        <p class="hero-description">{t('about.description')}</p>
      </div>
    </div>
  </div>

  <div class="container">
    <!-- Founding Members Section -->
    <div class="section-card">
      <h3 class="section-title">{t('about.founding_title')}</h3>
      <p class="section-date">{t('about.founding_date')}</p>

      <div class="founders-grid">
        <div class="founder-card">
          <div class="founder-icon">👤</div>
          <p class="founder-name">{t('about.founder_1')}</p>
        </div>
        <div class="founder-card">
          <div class="founder-icon">👤</div>
          <p class="founder-name">{t('about.founder_2')}</p>
        </div>
        <div class="founder-card">
          <div class="founder-icon">👤</div>
          <p class="founder-name">{t('about.founder_3')}</p>
        </div>
      </div>
    </div>

    <!-- History Section -->
    <div class="history-timeline">
      <div class="timeline-content">
        <h3 class="section-title">{t('about.history_title')}</h3>
        <p>{t('about.history_text')}</p>
      </div>
    </div>

    <!-- Mission & Vision Section -->
    <div class="mission-vision-grid">
      <div class="mission-card">
        <div class="card-icon">🎯</div>
        <h3>{t('about.mission_title')}</h3>
        <p>{t('about.mission_text')}</p>
      </div>
      <div class="vision-card">
        <div class="card-icon">🌟</div>
        <h3>{t('about.vision_title')}</h3>
        <p>{t('about.vision_text')}</p>
      </div>
    </div>

    <!-- Values Section -->
    <div class="values-section">
      <h3 class="section-title">{t('about.values_title')}</h3>
      <p class="section-intro">{t('about.values_intro')}</p>

      <div class="values-grid">
        <div class="value-card">
          <div class="value-icon">✨</div>
          <h4>{t('about.value_1_title')}</h4>
          <p>{t('about.value_1_text')}</p>
        </div>
        <div class="value-card">
          <div class="value-icon">🤝</div>
          <h4>{t('about.value_2_title')}</h4>
          <p>{t('about.value_2_text')}</p>
        </div>
        <div class="value-card">
          <div class="value-icon">💪</div>
          <h4>{t('about.value_3_title')}</h4>
          <p>{t('about.value_3_text')}</p>
        </div>
      </div>
    </div>

    <!-- Activity Areas / Pillars Section -->
    <div class="pillars-container">
      <h3 class="section-title">{t('about.pillars_title')}</h3>
      <div class="pillars-grid">
        <div class="pillar-card pillar-1">
          <div class="pillar-icon">👥</div>
          <h4>{t('about.pillar_1')}</h4>
          <p>{t('about.pillar_1_desc')}</p>
        </div>
        <div class="pillar-card pillar-2">
          <div class="pillar-icon">💼</div>
          <h4>{t('about.pillar_2')}</h4>
          <p>{t('about.pillar_2_desc')}</p>
        </div>
        <div class="pillar-card pillar-3">
          <div class="pillar-icon">🎭</div>
          <h4>{t('about.pillar_3')}</h4>
          <p>{t('about.pillar_3_desc')}</p>
        </div>
        <div class="pillar-card pillar-4">
          <div class="pillar-icon">🌱</div>
          <h4>{t('about.pillar_4')}</h4>
          <p>{t('about.pillar_4_desc')}</p>
        </div>
      </div>
    </div>

    <!-- Main Activities Section -->
    <div class="activities-section">
      <h3 class="section-title">{t('about.activities_title')}</h3>
      <div class="activities-list">
        <div class="activity-item">
          <div class="activity-number">1</div>
          <p>{t('about.activity_1')}</p>
        </div>
        <div class="activity-item">
          <div class="activity-number">2</div>
          <p>{t('about.activity_2')}</p>
        </div>
        <div class="activity-item">
          <div class="activity-number">3</div>
          <p>{t('about.activity_3')}</p>
        </div>
        <div class="activity-item">
          <div class="activity-number">4</div>
          <p>{t('about.activity_4')}</p>
        </div>
        <div class="activity-item">
          <div class="activity-number">5</div>
          <p>{t('about.activity_5')}</p>
        </div>
        <div class="activity-item">
          <div class="activity-number">6</div>
          <p>{t('about.activity_6')}</p>
        </div>
        <div class="activity-item">
          <div class="activity-number">7</div>
          <p>{t('about.activity_7')}</p>
        </div>
        <div class="activity-item">
          <div class="activity-number">8</div>
          <p>{t('about.activity_8')}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  #about {
    padding: 2rem 0 6rem;
    background: white;
  }

  /* Hero Section */
  .about-hero {
    background: linear-gradient(135deg, #4f46e5 0%, #ec4899 100%);
    color: white;
    padding: 6rem 0;
    margin-bottom: 4rem;
    border-radius: 0;
  }

  .hero-content {
    text-align: center;
  }

  .hero-badge {
    display: inline-block;
    background: rgba(255, 255, 255, 0.25);
    padding: 0.5rem 1.5rem;
    border-radius: 100px;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1.5rem;
  }

  #about h1 {
    font-size: 3.5rem;
    font-weight: 800;
    margin-bottom: 0.5rem;
    line-height: 1.1;
  }

  .hero-subtitle {
    font-size: 1.5rem;
    font-weight: 600;
    margin-bottom: 2rem;
    opacity: 0.95;
  }

  .hero-description {
    font-size: 1.1rem;
    line-height: 1.7;
    max-width: 800px;
    margin: 0 auto;
    opacity: 0.95;
  }

  /* General Section Styling */
  .section-card {
    background: white;
    padding: 3rem;
    border-radius: 24px;
    box-shadow: var(--shadow-sm);
    border: 1px solid #f1f5f9;
    margin-bottom: 3rem;
  }

  .section-title {
    font-size: 2rem;
    font-weight: 800;
    color: #1e293b;
    margin-bottom: 1rem;
    text-align: center;
  }

  .section-date {
    text-align: center;
    color: var(--color-primary);
    font-weight: 600;
    font-size: 0.95rem;
    margin-bottom: 2rem;
  }

  .section-intro {
    text-align: center;
    color: #475569;
    font-size: 1.05rem;
    margin-bottom: 2.5rem;
    line-height: 1.6;
  }

  /* Founders Section */
  .founders-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .founder-card {
    background: linear-gradient(135deg, #f0f9ff 0%, #faf5ff 100%);
    padding: 2rem;
    border-radius: 16px;
    text-align: center;
    border: 2px solid #f1f5f9;
    transition: all 0.3s ease;
  }

  .founder-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 24px rgba(79, 70, 229, 0.15);
  }

  .founder-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
  }

  .founder-name {
    font-size: 1.05rem;
    font-weight: 700;
    color: #1e293b;
    margin: 0;
  }

  /* History Timeline */
  .history-timeline {
    background: white;
    padding: 3rem;
    border-radius: 24px;
    box-shadow: var(--shadow-sm);
    border-left: 4px solid var(--color-primary);
    margin-bottom: 3rem;
    position: relative;
  }

  .history-timeline::before {
    content: '📖';
    position: absolute;
    top: -20px;
    left: 30px;
    font-size: 2.5rem;
  }

  .timeline-content h3 {
    color: var(--color-primary);
    margin-bottom: 1.5rem;
  }

  .timeline-content p {
    color: #475569;
    line-height: 1.8;
    font-size: 1rem;
  }

  /* Mission & Vision Grid */
  .mission-vision-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-bottom: 3rem;
  }

  .mission-card,
  .vision-card {
    background: white;
    padding: 2.5rem;
    border-radius: 24px;
    box-shadow: var(--shadow-sm);
    border: 1px solid #f1f5f9;
  }

  .mission-card {
    border-left: 4px solid var(--color-primary);
  }

  .vision-card {
    border-left: 4px solid var(--color-secondary);
  }

  .card-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .mission-card h3,
  .vision-card h3 {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 1rem;
    color: #1e293b;
  }

  .mission-card p,
  .vision-card p {
    color: #475569;
    line-height: 1.7;
    margin: 0;
  }

  /* Values Section */
  .values-section {
    background: linear-gradient(135deg, #f8fafc 0%, #f0f9ff 100%);
    padding: 3rem;
    border-radius: 24px;
    margin-bottom: 3rem;
  }

  .values-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .value-card {
    background: white;
    padding: 2rem;
    border-radius: 16px;
    text-align: center;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
    transition: all 0.3s ease;
  }

  .value-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 12px 24px rgba(79, 70, 229, 0.12);
  }

  .value-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .value-card h4 {
    font-size: 1.2rem;
    font-weight: 700;
    color: #1e293b;
    margin-bottom: 0.75rem;
  }

  .value-card p {
    color: #475569;
    font-size: 0.95rem;
    line-height: 1.6;
    margin: 0;
  }

  /* Pillars Container */
  .pillars-container {
    background: white;
    padding: 3rem;
    border-radius: 24px;
    box-shadow: var(--shadow-sm);
    border: 1px solid #f1f5f9;
    margin-bottom: 3rem;
  }

  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }

  .pillar-card {
    background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);
    padding: 2rem;
    border-radius: 16px;
    text-align: center;
    border: 2px solid #f1f5f9;
    transition: all 0.3s ease;
    position: relative;
  }

  .pillar-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 16px 32px rgba(0, 0, 0, 0.08);
  }

  .pillar-card.pillar-1 {
    border-top: 3px solid #3b82f6;
  }

  .pillar-card.pillar-2 {
    border-top: 3px solid #ef4444;
  }

  .pillar-card.pillar-3 {
    border-top: 3px solid #8b5cf6;
  }

  .pillar-card.pillar-4 {
    border-top: 3px solid #22c55e;
  }

  .pillar-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .pillar-card h4 {
    font-size: 1.1rem;
    font-weight: 700;
    color: #1e293b;
    margin-bottom: 0.75rem;
  }

  .pillar-card p {
    color: #475569;
    font-size: 0.9rem;
    line-height: 1.6;
    margin: 0;
  }

  /* Activities Section */
  .activities-section {
    background: linear-gradient(135deg, #f0fdf4 0%, #f0f9ff 100%);
    padding: 3rem;
    border-radius: 24px;
    margin-bottom: 2rem;
  }

  .activities-list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  .activity-item {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
  }

  .activity-number {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: linear-gradient(135deg, #4f46e5 0%, #ec4899 100%);
    color: white;
    font-weight: 800;
    border-radius: 50%;
    flex-shrink: 0;
    font-size: 1rem;
  }

  .activity-item p {
    color: #1e293b;
    font-weight: 600;
    line-height: 1.6;
    margin: 0;
  }

  /* Responsive Design */
  @media (max-width: 1024px) {
    #about h1 {
      font-size: 2.5rem;
    }

    .hero-subtitle {
      font-size: 1.25rem;
    }

    .founders-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .mission-vision-grid {
      grid-template-columns: 1fr;
    }

    .values-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .pillars-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .activities-list {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    #about {
      padding: 1rem 0 3rem;
    }

    .about-hero {
      padding: 3rem 0;
      margin-bottom: 2rem;
    }

    #about h1 {
      font-size: 2rem;
    }

    .hero-subtitle {
      font-size: 1.1rem;
    }

    .hero-description {
      font-size: 1rem;
    }

    .section-card,
    .history-timeline,
    .pillars-container,
    .activities-section {
      padding: 1.5rem;
      margin-bottom: 2rem;
    }

    .section-title {
      font-size: 1.5rem;
      margin-bottom: 1.5rem;
    }

    .founders-grid {
      grid-template-columns: 1fr;
    }

    .founder-card {
      padding: 1.5rem;
    }

    .values-grid {
      grid-template-columns: 1fr;
    }

    .pillars-grid {
      grid-template-columns: 1fr;
    }

    .mission-vision-grid {
      grid-template-columns: 1fr;
    }

    .activity-item {
      gap: 1rem;
    }

    .activity-number {
      width: 36px;
      height: 36px;
      font-size: 0.9rem;
    }
  }

  @media (max-width: 480px) {
    #about h1 {
      font-size: 1.75rem;
    }

    .hero-description {
      font-size: 0.95rem;
    }

    .section-title {
      font-size: 1.25rem;
    }

    .mission-card h3,
    .vision-card h3 {
      font-size: 1.25rem;
    }

    .value-card h4,
    .pillar-card h4 {
      font-size: 1rem;
    }
  }
</style>
