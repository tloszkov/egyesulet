---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const lang = 'ro';
---

<Layout title="Transparență - OSPC" lang={lang} description="Rapoarte anuale, documente publice și transparență financiară - Asociația O Șansă Pentru Comunitate">
  <Header lang={lang} />
  <main style="padding-top: 8rem; padding-bottom: 6rem;">
    <div class="container">
      <div class="page-header reveal">
        <span class="page-badge">Transparență 100%</span>
        <h1>Documente și Rapoarte</h1>
        <p>Credem în transparență totală față de comunitate. Toate documentele noastre publice sunt disponibile pentru descărcare.</p>
      </div>

      <div class="docs-grid reveal">

        <div class="doc-card">
          <div class="doc-icon doc-icon--statute">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
          </div>
          <div class="doc-info">
            <h3>Statut</h3>
            <p>Statutul Asociației O Șansă Pentru Comunitate — documentul fondator care stabilește scopul, structura și regulile organizației.</p>
            <span class="doc-meta">PDF · 2021</span>
          </div>
          <a href="/Statut.pdf" download class="btn-download">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
            Descarcă
          </a>
        </div>

        <div class="doc-card">
          <div class="doc-icon doc-icon--act">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
          </div>
          <div class="doc-info">
            <h3>Act Constitutiv</h3>
            <p>Actul constitutiv al asociației, semnat de membrii fondatori în data de 27 august 2021 la Cristuru Secuiesc.</p>
            <span class="doc-meta">PDF · 2021</span>
          </div>
          <a href="/Act constitutiv.pdf" download class="btn-download">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
            Descarcă
          </a>
        </div>

        <!-- Placeholder for annual reports -->
        <div class="doc-card doc-card--coming">
          <div class="doc-icon doc-icon--report">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
          </div>
          <div class="doc-info">
            <h3>Raport de Activitate 2023</h3>
            <p>Raportul anual de activitate cu prezentarea proiectelor, beneficiarilor și resurselor utilizate în anul 2023.</p>
            <span class="doc-meta doc-meta--soon">În curând</span>
          </div>
          <span class="btn-download btn-download--disabled">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
            În pregătire
          </span>
        </div>

        <div class="doc-card doc-card--coming">
          <div class="doc-icon doc-icon--finance">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="5" width="20" height="14" rx="2"></rect><line x1="2" y1="10" x2="22" y2="10"></line></svg>
          </div>
          <div class="doc-info">
            <h3>Bilanț Financiar 2023</h3>
            <p>Situația financiară anuală — venituri, cheltuieli și utilizarea fondurilor în anul fiscal 2023.</p>
            <span class="doc-meta doc-meta--soon">În curând</span>
          </div>
          <span class="btn-download btn-download--disabled">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
            În pregătire
          </span>
        </div>
      </div>

      <!-- Info block -->
      <div class="info-block reveal">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
        <p>Pentru orice solicitare de documente suplimentare sau informații despre activitatea noastră, te rugăm să ne contactezi la <a href="mailto:office@ospc.ro">office@ospc.ro</a>.</p>
      </div>
    </div>
  </main>
  <Footer lang={lang} />
</Layout>

<style>
  .page-header {
    text-align: center;
    padding: 2rem 0 4rem;
    max-width: 640px;
    margin: 0 auto;
  }
  .page-badge {
    display: inline-block;
    padding: 0.4rem 1rem;
    background: rgba(79,70,229,0.1);
    color: #4f46e5;
    border-radius: 100px;
    font-weight: 700;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1.25rem;
  }
  .page-header h1 {
    font-size: 3rem;
    color: #1e293b;
    margin-bottom: 1rem;
  }
  .page-header p {
    font-size: 1.15rem;
    color: #64748b;
    line-height: 1.7;
  }

  .docs-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .doc-card {
    background: white;
    border: 1px solid #e2e8f0;
    border-radius: 20px;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    transition: all 0.3s;
  }
  .doc-card:hover { box-shadow: 0 20px 40px -10px rgba(0,0,0,0.12); transform: translateY(-4px); }
  .doc-card--coming { opacity: 0.7; }
  .doc-card--coming:hover { transform: none; box-shadow: none; }

  .doc-icon {
    width: 56px;
    height: 56px;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .doc-icon--statute { background: rgba(79,70,229,0.1); color: #4f46e5; }
  .doc-icon--act { background: rgba(236,72,153,0.1); color: #ec4899; }
  .doc-icon--report { background: rgba(16,185,129,0.1); color: #10b981; }
  .doc-icon--finance { background: rgba(245,158,11,0.1); color: #f59e0b; }

  .doc-info { flex: 1; }
  .doc-info h3 { font-size: 1.15rem; font-weight: 700; color: #1e293b; margin-bottom: 0.5rem; }
  .doc-info p { font-size: 0.9rem; color: #64748b; line-height: 1.6; margin-bottom: 0.75rem; }

  .doc-meta {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #94a3b8;
  }
  .doc-meta--soon { color: #f59e0b; }

  .btn-download {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.25rem;
    background: #4f46e5;
    color: white;
    border-radius: 12px;
    font-weight: 700;
    font-size: 0.9rem;
    text-decoration: none;
    transition: all 0.2s;
    align-self: flex-start;
  }
  .btn-download:hover { background: #3730a3; transform: translateY(-1px); }
  .btn-download--disabled {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.25rem;
    background: #f1f5f9;
    color: #94a3b8;
    border-radius: 12px;
    font-weight: 700;
    font-size: 0.9rem;
    align-self: flex-start;
    cursor: not-allowed;
  }

  .info-block {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    background: rgba(79,70,229,0.05);
    border: 1px solid rgba(79,70,229,0.15);
    border-radius: 16px;
    padding: 1.5rem;
    color: #4f46e5;
  }
  .info-block svg { flex-shrink: 0; margin-top: 2px; }
  .info-block p { color: #475569; margin: 0; line-height: 1.6; }
  .info-block a { color: #4f46e5; font-weight: 700; text-decoration: none; }

  @media (max-width: 768px) {
    .docs-grid { grid-template-columns: 1fr; }
    .page-header h1 { font-size: 2.25rem; }
  }
</style>
